@model List<Payroll>

@{
    ViewData["Title"] = "Payroll Slips Management";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header sticky-payroll-header">
                    <h3 class="card-title">
                        <i class="fas fa-file-invoice-dollar"></i>
                        Payroll Slips Management
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Filter Section -->
                    <div class="slip-filter-card card mb-4">
                        <div class="card-body">
                            <form method="get">
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            <select name="payPeriod" class="form-select">
                                                <option value="">All Pay Periods</option>
                                                @foreach (var period in ViewBag.PayPeriods as List<SelectListItem>)
                                                {
                                                    <option value="@period.Value" selected="@period.Selected">@period.Text</option>
                                                }
                                            </select>
                                            <label>Pay Period (Ethiopian Calendar)</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            <select name="employeeId" class="form-select">
                                                <option value="">All Employees</option>
                                                @foreach (var emp in ViewBag.Employees as List<SelectListItem>)
                                                {
                                                    <option value="@emp.Value" selected="@emp.Selected">@emp.Text</option>
                                                }
                                            </select>
                                            <label>Employee</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating">
                                            <label>Department/Directorate</label>
                                            <select name="organizationUnitId" class="form-select">
                                                <option value="">All Departments/Directorates</option>
                                                @* Ensure ViewBag.OrganizationUnits is provided by the controller *@
                                                @foreach (var ou in ViewBag.OrganizationUnits as List<SelectListItem>)
                                                {
                                                    @if (ViewBag.SelectedOrganizationUnitId == ou.Value)
                                                    {
                                                        <option value="@ou.Value" selected>@ou.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@ou.Value">@ou.Text</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-search"></i> Filter
                                        </button>
                                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                                            <i class="fas fa-times"></i> Clear
                                        </a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        <!-- Export Section -->
                        <div class="export-button-group mb-3">
                            <div class="btn-group" role="group">
                                <a href="@Url.Action("ExportExcel", new { payPeriod = ViewBag.SelectedPayPeriod, employeeId = ViewBag.SelectedEmployeeId, organizationUnitId = ViewBag.SelectedOrganizationUnitId })" class="btn btn-success">
                                    <i class="fas fa-file-excel"></i> Export to Excel
                                </a>
                                <a href="@Url.Action("ExportCsv", new { payPeriod = ViewBag.SelectedPayPeriod, employeeId = ViewBag.SelectedEmployeeId, organizationUnitId = ViewBag.SelectedOrganizationUnitId })" class="btn btn-info">
                                    <i class="fas fa-file-csv"></i> Export to CSV
                                </a>
                                <a href="@Url.Action("ExportPdf", new { payPeriod = ViewBag.SelectedPayPeriod, employeeId = ViewBag.SelectedEmployeeId, organizationUnitId = ViewBag.SelectedOrganizationUnitId })" class="btn btn-danger">
                                    <i class="fas fa-file-pdf"></i> Export to PDF
                                </a>
                            </div>
                            <div class="btn-group ms-2" role="group">
                                <a href="@Url.Action("GenerateIndividualSlips", new { payPeriod = ViewBag.SelectedPayPeriod, employeeId = ViewBag.SelectedEmployeeId, organizationUnitId = ViewBag.SelectedOrganizationUnitId, type = "bank" })" class="btn btn-primary">
                                    <i class="fas fa-university"></i> Bank Slips
                                </a>
                                <a href="@Url.Action("GenerateIndividualSlips", new { payPeriod = ViewBag.SelectedPayPeriod, employeeId = ViewBag.SelectedEmployeeId, organizationUnitId = ViewBag.SelectedOrganizationUnitId, type = "report" })" class="btn btn-outline-primary">
                                    <i class="fas fa-file-alt"></i> Report Slips
                                </a>
                            </div>
                        </div>

                        <!-- Results Table -->
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Employee</th>
                                        <th>Badge #</th>
                                        <th>Department/Directorate</th>
                                        <th>Pay Period (ET)</th>
                                        <th>Basic Salary</th>
                                        <th>Gross Salary</th>
                                        <th>Total Deductions</th>
                                        <th>Net Salary</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payroll in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@payroll.Employee.FirstName @payroll.Employee.LastName</strong>
                                            </td>
                                            <td>@payroll.Employee.BadgeNumber</td>
                                            <td>@(payroll.Employee.OrganizationUnit?.Name ?? "N/A")</td>
                                            <td>
                                                <span class="ethiopian-date-highlight">
                                                    @payroll.PayPeriodStartEt - @payroll.PayPeriodEndEt
                                                </span>
                                                <br>
                                                <small class="text-muted">
                                                    @payroll.PayPeriodStart.ToString("MMM dd") - @payroll.PayPeriodEnd.ToString("MMM dd, yyyy")
                                                </small>
                                            </td>
                                            <td>
                                                <span class="payroll-amount">@payroll.BasicSalary.ToString("N2")</span>
                                            </td>
                                            <td>
                                                <span class="payroll-amount">@payroll.GrossSalary.ToString("N2")</span>
                                            </td>
                                            <td>
                                                <span class="payroll-amount text-danger">@payroll.TotalDeductions.ToString("N2")</span>
                                            </td>
                                            <td>
                                                <span class="payroll-amount text-success fw-bold">@payroll.NetSalary.ToString("N2") ETB</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("GenerateIndividualSlips", new { payPeriod = payroll.PayPeriodStart.ToString("yyyy-MM-dd") + "," + payroll.PayPeriodEnd.ToString("yyyy-MM-dd"), employeeId = payroll.EmployeeId, type = "bank" })" 
                                                       class="btn btn-sm btn-primary" title="Bank Slip">
                                                        <i class="fas fa-university"></i>
                                                    </a>
                                                    <a href="@Url.Action("GenerateIndividualSlips", new { payPeriod = payroll.PayPeriodStart.ToString("yyyy-MM-dd") + "," + payroll.PayPeriodEnd.ToString("yyyy-MM-dd"), employeeId = payroll.EmployeeId, type = "report" })" 
                                                       class="btn btn-sm btn-outline-primary" title="Report Slip">
                                                        <i class="fas fa-file-alt"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (ViewBag.TotalPages > 1)
                        {
                            <div class="d-flex justify-content-between align-items-center mt-3 mb-4">
                                <div>
                                    <span class="text-muted">
                                        Showing @((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1) to @(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalRecords)) of @ViewBag.TotalRecords records
                                    </span>
                                </div>
                                <nav aria-label="Payroll pagination">
                                    <ul class="pagination mb-0">
                                        @if (ViewBag.HasPreviousPage)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="@Url.Action("Index", new { payPeriod = ViewBag.SelectedPayPeriod, employeeId = ViewBag.SelectedEmployeeId, organizationUnitId = ViewBag.SelectedOrganizationUnitId, page = ViewBag.CurrentPage - 1 })">
                                                    <i class="fas fa-chevron-left"></i> Previous
                                                </a>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link"><i class="fas fa-chevron-left"></i> Previous</span>
                                            </li>
                                        }

                                        @{
                                            int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                                            int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);
                                        }

                                        @if (startPage > 1)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="@Url.Action("Index", new { payPeriod = ViewBag.SelectedPayPeriod, employeeId = ViewBag.SelectedEmployeeId, organizationUnitId = ViewBag.SelectedOrganizationUnitId, page = 1 })">1</a>
                                            </li>
                                            @if (startPage > 2)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                        }

                                        @for (int i = startPage; i <= endPage; i++)
                                        {
                                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                                @if (i == ViewBag.CurrentPage)
                                                {
                                                    <span class="page-link">@i</span>
                                                }
                                                else
                                                {
                                                    <a class="page-link" href="@Url.Action("Index", new { payPeriod = ViewBag.SelectedPayPeriod, employeeId = ViewBag.SelectedEmployeeId, organizationUnitId = ViewBag.SelectedOrganizationUnitId, page = i })">@i</a>
                                                }
                                            </li>
                                        }

                                        @if (endPage < ViewBag.TotalPages)
                                        {
                                            @if (endPage < ViewBag.TotalPages - 1)
                                            {
                                                <li class="page-item disabled">
                                                    <span class="page-link">...</span>
                                                </li>
                                            }
                                            <li class="page-item">
                                                <a class="page-link" href="@Url.Action("Index", new { payPeriod = ViewBag.SelectedPayPeriod, employeeId = ViewBag.SelectedEmployeeId, organizationUnitId = ViewBag.SelectedOrganizationUnitId, page = ViewBag.TotalPages })">@ViewBag.TotalPages</a>
                                            </li>
                                        }

                                        @if (ViewBag.HasNextPage)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="@Url.Action("Index", new { payPeriod = ViewBag.SelectedPayPeriod, employeeId = ViewBag.SelectedEmployeeId, organizationUnitId = ViewBag.SelectedOrganizationUnitId, page = ViewBag.CurrentPage + 1 })">
                                                    Next <i class="fas fa-chevron-right"></i>
                                                </a>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">Next <i class="fas fa-chevron-right"></i></span>
                                            </li>
                                        }
                                    </ul>
                                </nav>
                            </div>
                        }

                        <!-- Summary Statistics -->
                        <div class="row mt-4">
                            <div class="col-md-3">
                                <div class="slip-summary-card card">
                                    <div class="card-body text-center">
                                        <h5 class="card-title">Total Records</h5>
                                        <h3 class="text-primary">@ViewBag.TotalRecords</h3>
                                        <small class="text-muted">Showing @Model.Count on this page</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="slip-summary-card card">
                                    <div class="card-body text-center">
                                        <h5 class="card-title">Total Gross</h5>
                                        <h3 class="text-success">@Model.Sum(p => p.GrossSalary).ToString("N2") ETB</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="slip-summary-card card">
                                    <div class="card-body text-center">
                                        <h5 class="card-title">Total Deductions</h5>
                                        <h3 class="text-warning">@Model.Sum(p => p.TotalDeductions).ToString("N2") ETB</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="slip-summary-card card">
                                    <div class="card-body text-center">
                                        <h5 class="card-title">Total Net</h5>
                                        <h3 class="text-info">@Model.Sum(p => p.NetSalary).ToString("N2") ETB</h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-5">
                            <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No Payroll Records Found</h4>
                            <p class="text-muted">Use the filters above to search for payroll slips or ensure payroll has been generated for the desired period.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 