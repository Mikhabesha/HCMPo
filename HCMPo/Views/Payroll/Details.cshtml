@model HCMPo.Models.Payroll

@{
    ViewData["Title"] = "Payroll Details";
}

<div class="container-fluid">
    <h2>Payroll Details</h2>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Employee Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Employee</dt>
                        <dd class="col-sm-8">@Model.Employee.FullName</dd>

                        <dt class="col-sm-4">Department/Directorate</dt>
                        <dd class="col-sm-8">@Model.Employee.OrganizationUnit?.Name</dd>

                        <dt class="col-sm-4">Position</dt>
                        <dd class="col-sm-8">@Model.Employee.JobTitle?.Title</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Pay Period</dt>
                        <dd class="col-sm-8">@Model.PayPeriodStartEt - @Model.PayPeriodEndEt</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-@(Model.Status switch {
                                PayrollStatus.Draft => "secondary",
                                PayrollStatus.Generated => "primary",
                                PayrollStatus.Approved => "success",
                                PayrollStatus.Paid => "info",
                                PayrollStatus.Cancelled => "danger",
                                _ => "secondary"
                            })">@Model.Status</span>
                        </dd>

                        <dt class="col-sm-4">Generated By</dt>
                        <dd class="col-sm-8">@Model.GeneratedBy</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Allowances</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var allowance in Model.Allowances)
                                {
                                    <tr>
                                        <td>@allowance.AllowanceType.Name</td>
                                        <td>@allowance.Amount.ToString("N2")</td>
                                        <td>@allowance.Remarks</td>
                                    </tr>
                                }
                                @if (!Model.Allowances.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center">No allowances</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Total Allowances</th>
                                    <th colspan="2">@Model.Allowances.Sum(a => a.Amount).ToString("N2")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Deductions</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Income Tax</td>
                                    <td>@Model.IncomeTax.ToString("N2")</td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td>Pension</td>
                                    <td>@Model.PensionDeduction.ToString("N2")</td>
                                    <td></td>
                                </tr>
                                @foreach (var deduction in Model.Deductions)
                                {
                                    <tr>
                                        <td>@deduction.DeductionType</td>
                                        <td>@deduction.Amount.ToString("N2")</td>
                                        <td>@deduction.Remarks</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Total Deductions</th>
                                    <th colspan="2">@Model.TotalDeductions.ToString("N2")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Salary Summary</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Basic Salary</dt>
                        <dd class="col-sm-8">@Model.BasicSalary.ToString("N2")</dd>

                        <dt class="col-sm-4">Gross Salary</dt>
                        <dd class="col-sm-8">@Model.GrossSalary.ToString("N2")</dd>

                        <dt class="col-sm-4">Net Salary</dt>
                        <dd class="col-sm-8">@Model.NetSalary.ToString("N2")</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Working Days</dt>
                        <dd class="col-sm-8">@Model.WorkingDays</dd>

                        <dt class="col-sm-4">Days Worked</dt>
                        <dd class="col-sm-8">@Model.DaysWorked</dd>

                        <dt class="col-sm-4">Absent Days</dt>
                        <dd class="col-sm-8">@Model.AbsentDays</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="form-group">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
        @if (Model.Status == PayrollStatus.Draft)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i> Edit
            </a>
        }
    </div>
</div>
