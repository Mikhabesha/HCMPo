@model HCMPo.ViewModels.PayrollGenerationViewModel
@using HCMPo.Models
@using HCMPo.Helpers

@{
    ViewData["Title"] = "Generate Payroll";
    var deductionTypes = ViewBag.DeductionTypes as List<HCMPo.Models.DeductionType>;
}

<h2>Generate Payroll</h2>

<form asp-action="GeneratePayroll" method="post">
    <div class="mb-3">
        <label for="EmployeeId" class="form-label">Employee</label>
        <input asp-for="EmployeeId" class="form-control" />
    </div>
    <div class="mb-3">
        <label for="BasicSalary" class="form-label">Basic Salary</label>
        <input asp-for="BasicSalary" class="form-control" />
    </div>
    <div class="mb-3">
        <label for="Allowance" class="form-label">Allowance</label>
        <span>@(Model.Allowances != null && Model.Allowances.Any() ? Model.Allowances.Sum(a => a.Amount) : 0)</span>
    </div>
    <div class="mb-3">
        <label class="form-label">Start Date (የደመወዝ ጊዜ መጀመሪያ ቀን)</label>
        @{
            ViewBag.Id = "StartDate";
            ViewBag.Name = "StartDate";
            ViewBag.Label = "Start Date (የደመወዝ ጊዜ መጀመሪያ ቀን)";
            ViewBag.Required = true;
            ViewBag.ShowGregorian = true;
        }
        @await Html.PartialAsync("_EthiopianDatePicker")
        <input asp-for="StartDate" type="hidden" id="StartDateGregorian" />
    </div>
    <div class="mb-3">
        <label class="form-label">End Date (የደመወዝ ጊዜ መጨረሻ ቀን)</label>
        @{
            ViewBag.Id = "EndDate";
            ViewBag.Name = "EndDate";
            ViewBag.Label = "End Date (የደመወዝ ጊዜ መጨረሻ ቀን)";
            ViewBag.Required = true;
            ViewBag.ShowGregorian = true;
        }
        @await Html.PartialAsync("_EthiopianDatePicker")
        <input asp-for="EndDate" type="hidden" id="EndDateGregorian" />
    </div>
    <h4>Deductions</h4>
    <div class="row">
        @foreach (var type in deductionTypes)
        {
            var deduction = Model.Deductions.FirstOrDefault(d => d.DeductionTypeId == type.Id);
            <div class="col-md-3 mb-3">
                <label class="form-label">@type.DisplayName</label>
                <input name="Deductions[@type.Id].Amount" class="form-control" type="number" step="0.01" value="@(deduction != null ? deduction.Amount : 0)" />
                <input name="Deductions[@type.Id].Remarks" class="form-control mt-1" type="text" placeholder="Remarks" value="@(deduction != null ? deduction.Remarks : "")" />
            </div>
        }
    </div>
    <button type="submit" class="btn btn-primary">Generate Payroll</button>
</form> 

<script>
    // Sync Ethiopian date picker values with hidden inputs
    $('form').on('submit', function(e) {
        syncEthiopianDates();
    });

    function syncEthiopianDates() {
        // Start Date
        const startGregorian = $('#StartDateGregorian').val();
        if (startGregorian) {
            $('#StartDate').val(startGregorian);
        }

        // End Date
        const endGregorian = $('#EndDateGregorian').val();
        if (endGregorian) {
            $('#EndDate').val(endGregorian);
        }
    }
</script> 