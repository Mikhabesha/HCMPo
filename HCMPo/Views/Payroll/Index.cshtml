@model IEnumerable<HCMPo.ViewModels.PayrollPeriodGroupViewModel>
@using HCMPo.Models
@using HCMPo.Helpers

@{
    ViewData["Title"] = "Payroll Periods";
}

<h1>Payroll Periods</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Payroll Period (Ethiopian)</th>
            <th>Sent Date</th>
            <th>Status</th>
            <th>Approved By</th>
            <th>Payroll Count</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var period in Model)
        {
            <tr>
                <td>
                    @if (DateTime.TryParse(period.PayPeriodStartEt, out var startDate) && DateTime.TryParse(period.PayPeriodEndEt, out var endDate))
                    {
                        @Html.Raw($"{EthiopianCalendarHelper.FormatDateCompact(startDate)} - {EthiopianCalendarHelper.FormatDateCompact(endDate)}")
                    }
                    else
                    {
                        @($"{period.PayPeriodStartEt} - {period.PayPeriodEndEt}")
                    }
                </td>
                <td>@(period.SentDate.HasValue ? Html.Raw(EthiopianCalendarHelper.FormatDateWithEthiopian(period.SentDate.Value, "yyyy-MM-dd HH:mm")) : "-")</td>
                <td>
                    @if (!period.IsOpened)
                    {
                        <span class="badge" style="background-color:#f8d7da;color:#721c24;">In Progress</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Payment Ordered</span>
                    }
                </td>
                <td>@period.ApprovedBy</td>
                <td>@period.PayrollCount</td>
                <td>
                    <a asp-action="PayrollList" asp-route-periodId="@period.PeriodId" class="btn btn-primary btn-sm">See List</a>
                </td>
            </tr>
        }
    </tbody>
</table>
