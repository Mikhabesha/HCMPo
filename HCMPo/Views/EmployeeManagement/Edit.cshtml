@model HCMPo.Models.Employee
@using HCMPo.Helpers

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-user-edit"></i>
                        Edit Employee - @Model.FullName
                    </h3>
                    <div class="card-tools">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" id="editEmployeeForm">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="CreatedBy" />
                        <input type="hidden" asp-for="ApplicationUserId" />
                        <input type="hidden" asp-for="UserId" />
                        
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="row">
                            <!-- Personal Information Section -->
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">
                                    <i class="fas fa-user"></i> Personal Information
                                </h5>
                                
                                <div class="form-group mb-3">
                                    <label asp-for="FirstName" class="form-label"></label>
                                    <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="LastName" class="form-label"></label>
                                    <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control" placeholder="Enter email address" type="email" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="PhoneNumber" class="form-label"></label>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Gender" class="form-label"></label>
                                    <select asp-for="Gender" class="form-control">
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Date of Birth (የተወለደበት ቀን)</label>
                                        @await Html.PartialAsync("_EthiopianDatePicker", new { Id = "DateOfBirth", Name = "DateOfBirth", Label = "Date of Birth (የተወለደበት ቀን)", IsRequired = true, ShowGregorian = true, InitialDate = Model.DateOfBirth != default(DateTime) ? Model.DateOfBirth : (DateTime?)null, Placeholder = "Select Date of Birth" })
                                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Employment Date (የስራ መጀመሪያ ቀን)</label>
                                        @await Html.PartialAsync("_EthiopianDatePicker", new { Id = "EmploymentDate", Name = "EmploymentDate", Label = "Employment Date (የስራ መጀመሪያ ቀን)", IsRequired = true, ShowGregorian = true, InitialDate = Model.EmploymentDate != default(DateTime) ? Model.EmploymentDate : (DateTime?)null, Placeholder = "Select Employment Date" })
                                        <span asp-validation-for="EmploymentDate" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Hire Date (የተቀጠረበት ቀን)</label>
                                        @await Html.PartialAsync("_EthiopianDatePicker", new { Id = "HireDate", Name = "HireDate", Label = "Hire Date", IsRequired = false, ShowGregorian = true, InitialDate = Model.HireDate != default(DateTime) ? Model.HireDate : (DateTime?)null, Placeholder = "Select Hire Date" })
                                        <span asp-validation-for="HireDate" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Employment Information Section -->
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">
                                    <i class="fas fa-briefcase"></i> Employment Information
                                </h5>

                                <div class="form-group mb-3">
                                    <label asp-for="BadgeNumber" class="form-label"></label>
                                    <div class="input-group">
                                        <input asp-for="BadgeNumber" class="form-control" placeholder="Enter badge number" id="badgeNumber" />
                                        <button type="button" class="btn btn-outline-secondary" onclick="checkBadgeNumber()">
                                            <i class="fas fa-search"></i> Check
                                        </button>
                                    </div>
                                    <span asp-validation-for="BadgeNumber" class="text-danger"></span>
                                    <div id="badgeNumberStatus" class="mt-1"></div>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="OrganizationUnitId" class="form-label">Department/Directorate</label>
                                    <select asp-for="OrganizationUnitId" class="form-control" asp-items="ViewBag.OrganizationUnits">
                                        <option value="">Select Organization Unit</option>
                                    </select>
                                    <span asp-validation-for="OrganizationUnitId" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="JobTitleId" class="form-label">Job Title</label>
                                    <select asp-for="JobTitleId" class="form-control" asp-items="ViewBag.JobTitles">
                                        <option value="">Select Job Title</option>
                                    </select>
                                    <span asp-validation-for="JobTitleId" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="BasicSalary" class="form-label"></label>
                                    <input asp-for="BasicSalary" class="form-control" placeholder="Enter basic salary" type="number" step="0.01" />
                                    <span asp-validation-for="BasicSalary" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Status" class="form-label"></label>
                                    <select asp-for="Status" class="form-control" asp-items="ViewBag.Statuses">
                                        <option value="">Select Status</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Additional Information Section -->
                        <div class="row">
                            <div class="col-12">
                                <h5 class="text-primary mb-3 mt-3">
                                    <i class="fas fa-info-circle"></i> Additional Information
                                </h5>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Address" class="form-label"></label>
                                    <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter address"></textarea>
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="City" class="form-label"></label>
                                    <input asp-for="City" class="form-control" placeholder="Enter city" />
                                    <span asp-validation-for="City" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Position" class="form-label"></label>
                                    <input asp-for="Position" class="form-control" placeholder="Enter position" />
                                    <span asp-validation-for="Position" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="BankName" class="form-label"></label>
                                    <input asp-for="BankName" class="form-control" placeholder="Enter bank name" />
                                    <span asp-validation-for="BankName" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="BankAccountNumber" class="form-label"></label>
                                    <input asp-for="BankAccountNumber" class="form-control" placeholder="Enter bank account number" />
                                    <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="TinNumber" class="form-label"></label>
                                    <input asp-for="TinNumber" class="form-control" placeholder="Enter TIN number" />
                                    <span asp-validation-for="TinNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- User Account Information -->
                        @if (!string.IsNullOrEmpty(Model.ApplicationUserId))
                        {
                            <div class="row">
                                <div class="col-12">
                                    <div class="alert alert-info">
                                        <i class="fas fa-user-check"></i>
                                        This employee has a linked user account (ID: @Model.ApplicationUserId)
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="fas fa-save"></i> Update Employee
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                                <i class="fas fa-eye"></i> View Details
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let badgeNumberValid = true; // Assumed valid on edit, but can be re-checked

            function checkBadgeNumber() {
                const badgeNumber = document.getElementById('badgeNumber').value.trim();
                const excludeId = '@Model.Id';
                const statusDiv = document.getElementById('badgeNumberStatus');
                
                if (!badgeNumber) {
                    statusDiv.innerHTML = '<small class="text-warning"><i class="fas fa-exclamation-triangle"></i> Please enter a badge number</small>';
                    badgeNumberValid = false;
                    return;
                }
                statusDiv.innerHTML = '<small class="text-info"><i class="fas fa-spinner fa-spin"></i> Checking...</small>';
                fetch(`@Url.Action("CheckBadgeNumber", "EmployeeManagement")?badgeNumber=${badgeNumber}&excludeEmployeeId=${excludeId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.isAvailable) {
                            statusDiv.innerHTML = '<small class="text-success"><i class="fas fa-check-circle"></i> Badge number is available</small>';
                            badgeNumberValid = true;
                        } else {
                            statusDiv.innerHTML = '<small class="text-danger"><i class="fas fa-times-circle"></i> ' + data.message + '</small>';
                            badgeNumberValid = false;
                        }
                    });
            }
            document.getElementById('badgeNumber').addEventListener('input', checkBadgeNumber);

            document.getElementById('editEmployeeForm').addEventListener('submit', function(e) {
                var allDatesValid = true;
                ['DateOfBirth', 'HireDate', 'EmploymentDate'].forEach(function(id) {
                    var input = document.getElementById(id + 'Gregorian');
                    if (input && !input.value) {
                         // Only check required dates
                        if (id === 'DateOfBirth' || id === 'EmploymentDate') {
                            allDatesValid = false;
                        }
                    }
                });

                if (!allDatesValid) {
                    e.preventDefault();
                    Swal.fire('Validation Error', 'Please select all required dates.', 'error');
                }
                if (!badgeNumberValid) {
                    e.preventDefault();
                    Swal.fire('Validation Error', 'Badge number is not available. Please enter a unique one.', 'error');
                }
            });
        });
    </script>
} 