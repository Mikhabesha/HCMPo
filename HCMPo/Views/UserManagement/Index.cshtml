@{
    ViewData["Title"] = "User Management";
}

@section Styles {
    <link href="~/lib/datatables/dataTables.bootstrap5.min.css" rel="stylesheet">
}

@Html.AntiForgeryToken()

@if (User.IsInRole("Admin"))
{
    @* <div class="mb-3"> *@
    @*     <button class="btn btn-warning" id="fixLinksBtn" type="button"> *@
    @*         <i class="mdi mdi-link-variant"></i> Fix Employee-User Links (TEMP) *@
    @*     </button> *@
    @* </div> *@
}

<div class="container-fluid px-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-2 text-gray-800">User Management</h1>
                    <p class="mb-0 text-muted">Unified user and account management for all employees</p>
                </div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item active">User Management</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <span class="text-white-75 mb-3 lh-1 d-block">Total Users</span>
                            <h4 class="mb-0" id="totalUsers">@((ViewBag.TotalUsers != null ? ViewBag.TotalUsers : 0))</h4>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <span class="text-white-75 mb-3 lh-1 d-block">Linked to Employees</span>
                            <h4 class="mb-0" id="linkedUsers">@((ViewBag.LinkedUsers != null ? ViewBag.LinkedUsers : 0))</h4>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-user-check fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <span class="text-white-75 mb-3 lh-1 d-block">Unlinked Employees</span>
                            <h4 class="mb-0" id="unlinkedEmployees">@((ViewBag.UnlinkedEmployees != null ? ViewBag.UnlinkedEmployees : 0))</h4>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-user-times fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <span class="text-white-75 mb-3 lh-1 d-block">Active Roles</span>
                            <h4 class="mb-0" id="totalRoles">@((ViewBag.TotalRoles != null ? ViewBag.TotalRoles : 0))</h4>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-user-shield fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @* <div class="col-md-3">
                            <button type="button" class="btn btn-success w-100" onclick="createBulkUsers()" id="bulkCreateBtn">
                                <i class="fas fa-user-plus me-1"></i>
                                Create User Accounts for All Employees
                            </button>
                        </div> *@
                        <div class="col-md-3">
                            <button type="button" class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#createUserModal">
                                <i class="fas fa-user-plus me-1"></i>
                                Create Individual User
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-info w-100" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                                <i class="fas fa-user-shield me-1"></i>
                                Create New Role
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-secondary w-100" onclick="refreshData()">
                                <i class="fas fa-refresh me-1"></i>
                                Refresh Data
                            </button>
                        </div>
                        <div class="col-md-3">
                            <a href="/UserManagement/ArchivedUsers" class="btn btn-dark w-100">
                                <i class="fas fa-archive me-1"></i>
                                View Archived Users
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <form class="row g-2 align-items-end" method="get" action="/UserManagement">
                <div class="col-md-4">
                    <label for="searchTerm" class="form-label mb-0">Search</label>
                    <input type="text" class="form-control" id="searchTerm" name="searchTerm" placeholder="Email or Username" value="@ViewBag.SelectedSearchTerm">
                </div>
                <div class="col-md-3">
                    <label for="roleFilter" class="form-label mb-0">Role</label>
                    <select class="form-select" id="roleFilter" name="roleFilter">
                        <option value="" selected="@(ViewBag.SelectedRole == null ? "selected" : null)">All Roles</option>
                        @foreach (var role in ViewBag.AllRoles as List<string> ?? new List<string>())
                        {
                            <option value="@role" selected="@(ViewBag.SelectedRole == role ? "selected" : null)">@role</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="statusFilter" class="form-label mb-0">Status</label>
                    <select class="form-select" id="statusFilter" name="statusFilter">
                        @{
                            var statusOptions = new[] { "Active", "OnLeave", "Suspended", "Terminated", "Locked" };
                        }
                        <option value="" selected="@(ViewBag.SelectedStatus == null ? "selected" : null)">All Statuses</option>
                        @foreach (var status in statusOptions)
                        {
                            var display = status == "OnLeave" ? "On Leave" : status;
                            <option value="@status" selected="@(ViewBag.SelectedStatus == status ? "selected" : null)">@display</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-1"></i>Search</button>
                    <button type="button" class="btn btn-outline-secondary w-100" onclick="clearUserFilters()"><i class="fas fa-eraser me-1"></i>Clear</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">System Users</h5>
                    <button class="btn btn-success btn-sm me-2" onclick="createBulkUsers()" id="bulkCreateBtn2">
                        <i class="fas fa-user-plus me-1"></i>Create Accounts for Employees
                    </button>
                    <button class="btn btn-soft-primary btn-sm" onclick="refreshData()">
                        <i class="fas fa-refresh me-1"></i>Refresh
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="usersTable">
                            <thead class="table-dark">
                            <tr>
                                <th>Email</th>
                                <th>Employee</th>
                                <th>Roles</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.Users != null)
                            {
                                    foreach (var user in ViewBag.Users)
                                {
                                    <tr>
                                        <td>@user.Email</td>
                                        <td>
                                            @if (user.Employee != null)
                                            {
                                                    <span>@user.Employee.FullName (@user.Employee.BadgeNumber) - @user.Employee.OrganizationUnit</span>
                                            }
                                            else
                                            {
                                                    <span class="text-muted">Unlinked</span>
                                            }
                                        </td>
                                        <td>
                                                @if (user.Roles != null && user.Roles.Count > 0)
                                            {
                                                    foreach (var role in user.Roles)
                                                {
                                                        <span class="badge bg-primary me-1">@role</span>
                                                }
                                            }
                                                else
                                                {
                                                    <span class="text-muted">None</span>
                                            }
                                        </td>
                                        <td>
                                            @if (user.IsLocked)
                                            {
                                                <span class="badge bg-danger">Locked</span>
                                            }
                                                else
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                        </td>
                                        <td>
                                                <div class="btn-group" role="group">
                                                    @if (user.Employee != null && user.Employee.Id != null)
                                                    {
                                                        <a href="/Employees/Details/@user.Employee.Id" class="btn btn-outline-info btn-sm" data-bs-toggle="tooltip" title="View Employee Details">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                        <a href="/Employees/Edit/@user.Employee.Id" class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip" title="Edit Employee">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        <button class="btn btn-outline-danger btn-sm" onclick="unlinkUserFromEmployee('@user.Id', '@user.Employee.Id')" data-bs-toggle="tooltip" title="Unlink User & Employee">
                                                            <i class="fas fa-unlink"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-outline-primary btn-sm" disabled data-bs-toggle="tooltip" title="No linked employee"><i class="fas fa-edit"></i></button>
                                                    }
                                                    <button class="btn btn-secondary btn-sm" onclick="openRoleModal('@user.Id', @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(user.Roles ?? new List<string>())), @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.AllRoles ?? new List<string>())))" data-bs-toggle="tooltip" title="Change Role"><i class="fas fa-user-tag"></i></button>
                                                    <button class="btn btn-warning btn-sm" onclick="resetPassword('@user.Id')" data-bs-toggle="tooltip" title="Reset Password"><i class="fas fa-key"></i></button>
                                                    <button class="btn btn-danger btn-sm" onclick="lockUnlockUser('@user.Id', @user.IsLocked.ToString().ToLower())" data-bs-toggle="tooltip" title="@(user.IsLocked ? "Unlock this user (allow login)" : "Lock this user (prevent login)")">
                                                        <i class="fas fa-lock"></i>
                                                    </button>
                                                    <button class="btn btn-danger btn-sm" onclick="deleteUser('@user.Id')" data-bs-toggle="tooltip" title="Delete User"><i class="fas fa-trash"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                    <tr><td colspan="5" class="text-center text-muted">No users found.</td></tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createUserModalLabel">Create New User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/UserManagement/CreateUser" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" name="email" required>
                                <div class="form-text">Format: firstname@hcm.com</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" class="form-control" id="password" name="password" required>
                                <div class="form-text">Minimum 6 characters</div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                    <div class="mb-3">
                                <label for="employeeId" class="form-label">Link to Employee (Optional)</label>
                                <select class="form-select" id="employeeId" name="employeeId">
                                    <option value="">-- Select Employee --</option>
                        </select>
                                <div class="form-text">Only shows employees without user accounts</div>
                    </div>
                        </div>
                        <div class="col-md-6">
                    <div class="mb-3">
                                <label class="form-label">Roles</label>
                                <div class="role-checkboxes">
                                @foreach (var role in (ViewBag.AllRoles as List<string> ?? new List<string>()))
                                {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="roles" value="@role" id="role_@role">
                                            <label class="form-check-label" for="role_@role">@role</label>
                                    </div>
                                }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="mdi mdi-account-plus me-1"></i>Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Create Role Modal -->
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-labelledby="createRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createRoleModalLabel">Create New Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="roleName" class="form-label">Role Name</label>
                    <input type="text" class="form-control" id="roleName" placeholder="e.g., Manager, Supervisor">
                </div>
                <div class="mb-3">
                    <label for="roleDescription" class="form-label">Description (Optional)</label>
                    <textarea class="form-control" id="roleDescription" rows="3" placeholder="Role description..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="createRole()">Create Role</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit User Roles Modal -->
<div class="modal fade" id="editRolesModal" tabindex="-1" aria-labelledby="editRolesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editRolesModalLabel">Edit User Roles</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editUserId">
                <div class="mb-3">
                    <label class="form-label">Assign Roles</label>
                    <div id="editRolesContainer">
                        <!-- Roles will be populated here -->
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="saveUserRoles()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Change Role Modal -->
<div class="modal fade" id="changeRoleModal" tabindex="-1" aria-labelledby="changeRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="changeRoleModalLabel">Change User Roles</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="changeRoleForm">
                    <input type="hidden" id="roleUserId">
                    <div id="roleCheckboxes" class="mb-3"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitRoleChange()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Manual Admin Role Assignment Utility -->
@if (User.IsInRole("Admin"))
{
    <div class="card mt-5">
        <div class="card-header bg-warning text-dark">
            <strong>Admin Utility: Assign Roles to Any User</strong>
        </div>
        <div class="card-body">
            <form id="manualRoleAssignForm" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label for="manualUserId" class="form-label">Employee Name</label>
                    <select class="form-select" id="manualUserId" name="manualUserId" required>
                        <option value="">Select Employee</option>
                        @foreach (var user in (ViewBag.Users as IEnumerable<dynamic> ?? new List<dynamic>()))
                        {
                            if(user.Employee != null)
                            {
                                <option value="@user.Id">@user.Employee.FullName</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="manualRoles" class="form-label">Roles</label>
                    <div id="manualRoles">
                        @foreach (var role in (ViewBag.AllRoles as List<string> ?? new List<string>()))
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="roles" value="@role" id="manual_role_@role">
                                <label class="form-check-label" for="manual_role_@role">@role</label>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-danger">Assign Roles</button>
                </div>
            </form>
        </div>
    </div>
}

