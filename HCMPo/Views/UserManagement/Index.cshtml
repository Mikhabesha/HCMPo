        function createBulkUsers() {
            console.log('createBulkUsers function called');
            
            Swal.fire({
                title: 'Create User Accounts?',
                text: 'This will create user accounts for all employees without user accounts.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Create Accounts',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#198754'
            }).then((result) => {
                if (result.isConfirmed) {
                    performBulkUserCreation();
                }
            });
        }
        function performBulkUserCreation() {
            console.log('Starting bulk user creation process');
            
            // Find all buttons with this function to disable them
            const buttons = $('button[onclick*="createBulkUsers"]');
            const originalTexts = [];
            
            buttons.each(function(index) {
                originalTexts[index] = $(this).html();
                $(this).html('<i class="mdi mdi-loading mdi-spin me-1"></i>Creating...');
                $(this).prop('disabled', true);
            });

            // Get the antiforgery token
            const token = $('input[name="__RequestVerificationToken"]').val();
            console.log('Using antiforgery token:', token ? 'Found' : 'Not found');

            $.ajax({
                url: '/UserManagement/CreateAccountsForEmployeesWithoutUsers',
                type: 'POST',
                data: {
                    __RequestVerificationToken: token
                },
                dataType: 'json',
                timeout: 60000, // 60 second timeout
                success: function(response) {
                    console.log('Bulk creation response:', response);
                    
                    if (response.success) {
                        Swal.fire({
                            title: 'Success!',
                            html: `
                                <div class="text-start">
                                    <p class="mb-3">User accounts processed successfully!</p>
                                    <ul class="list-unstyled">
                                        <li class="mb-2"><i class="mdi mdi-check-circle text-success me-2"></i><strong>Created:</strong> ${response.created} new accounts</li>
                                        <li class="mb-2"><i class="mdi mdi-link text-info me-2"></i><strong>Linked:</strong> ${response.linked} existing accounts</li>
                                        <li class="mb-2"><i class="mdi mdi-alert-circle text-warning me-2"></i><strong>Errors:</strong> ${response.errors}</li>
                                    </ul>
                                    ${response.hasPasswordReport ? '<div class="alert alert-info mt-3"><i class="mdi mdi-download me-2"></i>Password report is ready for download.</div>' : ''}
                                </div>
                            `,
                            icon: 'success',
                            showCancelButton: response.hasPasswordReport,
                            confirmButtonText: response.hasPasswordReport ? 'Download Password Report' : 'OK',
                            cancelButtonText: 'Close',
                            allowOutsideClick: false
                        }).then((result) => {
                            if (result.isConfirmed && response.hasPasswordReport) {
                                window.location.href = '/UserManagement/DownloadPasswordReport';
                            }
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', response.message || 'Failed to create user accounts', 'error');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Bulk creation failed:', { xhr, status, error });
                    
                    let errorMessage = 'Failed to create user accounts';
                    if (status === 'timeout') {
                        errorMessage = 'Request timed out. Please try again.';
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    
                    Swal.fire('Error', errorMessage, 'error');
                },
                complete: function() {
                    console.log('Bulk creation request completed, restoring buttons');
                    
                    // Restore button states
                    buttons.each(function(index) {
                        $(this).html(originalTexts[index]);
                        $(this).prop('disabled', false);
                    });
                }
            });
        }
