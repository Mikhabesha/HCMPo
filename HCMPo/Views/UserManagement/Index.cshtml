@section Scripts {
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>

    <script>
        var allRolesForJs = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.AllRoles ?? new List<string>()));

        $(document).ready(function() {
            console.log('User Management page loaded');
            
            $('#usersTable').DataTable({
                "pageLength": 100,
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]]
            });
            
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
            
            loadSystemInfo();

            $('#createUserModal').on('show.bs.modal', function() {
                console.log('Create user modal opening, loading employees');
                loadEmployeesForLinking();
            });
    
            $.ajaxSetup({
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                }
            });
        });

function resetPassword(userId) {
    console.log('resetPassword called for', userId);
    resetUserPassword(userId);
}
function lockUnlockUser(userId, isLocked) {
    console.log('lockUnlockUser called for', userId, isLocked);
    const action = isLocked ? 'Unlock' : 'Lock';
    Swal.fire({
        title: `${action.charAt(0).toUpperCase() + action.slice(1)} User?`,
        text: isLocked ? 'This will allow the user to log in again.' : 'This will prevent the user from logging in.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: `Yes, ${action.charAt(0).toUpperCase() + action.slice(1)}`,
        cancelButtonText: 'Cancel',
        confirmButtonColor: isLocked ? '#28a745' : '#dc3545'
    }).then((result) => {
        if (result.isConfirmed) {
            $.post('/UserManagement/ToggleUserLock', { userId: userId, lockUser: !isLocked })
                .done(function(response) {
                    if (response.success) {
                        Swal.fire('Success!', response.message, 'success').then(() => location.reload());
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                })
                .fail(function() {
                    Swal.fire('Error', 'An error occurred while updating user status.', 'error');
                });
        }
    });
}
function deleteUser(userId) {
    console.log('deleteUser called for', userId);
    Swal.fire({
        title: 'Delete User?',
        text: 'This will deactivate (archive) the user and prevent login. This action can be undone from Archived Users.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Yes, Delete',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#dc3545'
    }).then((result) => {
        if (result.isConfirmed) {
            $.post('/UserManagement/DeactivateUser', { userId: userId })
                .done(function(response) {
                    if (response.success) {
                        Swal.fire('Deleted!', response.message, 'success').then(() => location.reload());
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                })
                .fail(function() {
