function openRoleModal(userId, userRoles, allRoles) {
    console.log('openRoleModal called', { userId, userRoles, allRoles });
    userRoles = userRoles || [];
    allRoles = allRoles || [];
    $('#roleUserId').val(userId);
    let html = '';
    allRoles.forEach(function(role) {
        const checked = userRoles && userRoles.includes(role) ? 'checked' : '';
        html += `<div class='form-check'>
            <input class='form-check-input' type='checkbox' name='roles' value='${role}' id='role_${role}' ${checked}>
            <label class='form-check-label' for='role_${role}'>${role}</label>
        </div>`;
    });
    $('#roleCheckboxes').html(html);
    const modal = new bootstrap.Modal(document.getElementById('changeRoleModal'));
    modal.show();
}
