@{
    ViewData["Title"] = "Archived Users";
}
<div class="container-fluid px-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-2 text-gray-800">Archived Users</h1>
                    <p class="mb-0 text-muted">List of all deactivated/archived users. You can view details or restore accounts.</p>
                </div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/UserManagement">User Management</a></li>
                        <li class="breadcrumb-item active">Archived Users</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Archived Users</h5>
                    <div>
                        <button class="btn btn-success mb-0 me-2" onclick="bulkRestore()">
                            <i class="fas fa-undo"></i> Restore All
                        </button>
                        <a href="/UserManagement" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Back to User Management
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="archivedUsersTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>Email</th>
                                    <th>Employee</th>
                                    <th>Roles</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.ArchivedUsers != null)
                                {
                                    foreach (var user in ViewBag.ArchivedUsers)
                                    {
                                        <tr>
                                            <td>@user.Email</td>
                                            <td>
                                                @if (user.Employee != null)
                                                {
                                                    <span>@user.Employee.FullName (@user.Employee.BadgeNumber) - @user.Employee.OrganizationUnit?.Name</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unlinked</span>
                                                }
                                            </td>
                                            <td>
                                                @if (user.Roles != null && user.Roles.Count > 0)
                                                {
                                                    foreach (var role in user.Roles)
                                                    {
                                                        <span class="badge bg-primary me-1">@role</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">None</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">Archived</span>
                                            </td>
                                            <td>
                                                @if (user.Employee != null && user.Employee?.Id != null)
                                                {
                                                    <button class="btn btn-sm btn-info me-1" onclick="viewEmployee('@user.Employee.Id')" data-bs-toggle="tooltip" title="View Employee Details"><i class="fas fa-eye"></i></button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-info me-1" disabled data-bs-toggle="tooltip" title="No linked employee"><i class="fas fa-eye"></i></button>
                                                }
                                                <button class="btn btn-sm btn-success" onclick="restoreUser('@user.Id')" data-bs-toggle="tooltip" title="Restore User"><i class="fas fa-undo"></i> Restore</button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="text-center text-muted">No archived users found.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>
    function restoreUser(userId) {
        Swal.fire({
            title: 'Restore User?',
            text: 'This will reactivate the user and allow them to log in again.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Restore',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#28a745'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/UserManagement/RestoreUser', { userId: userId })
                    .done(function(response) {
                        if (response.success) {
                            Swal.fire('Restored!', response.message, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    })
                    .fail(function() {
                        Swal.fire('Error', 'An error occurred while restoring the user.', 'error');
                    });
            }
        });
    }
    function bulkRestore() {
        const userIds = [];
        $('#archivedUsersTable tbody tr').each(function() {
            const restoreBtn = $(this).find('button.btn-success');
            if (restoreBtn.length) {
                const userId = restoreBtn.attr('onclick').match(/'([^']+)'/)[1];
                userIds.push(userId);
            }
        });
        if (userIds.length === 0) {
            Swal.fire('Info', 'No users to restore.', 'info');
            return;
        }
        Swal.fire({
            title: 'Restore All Users?',
            text: 'This will reactivate all archived users.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Restore All',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#28a745'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/UserManagement/BulkRestoreUsers',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(userIds),
                    success: function(response) {
                        if (response.success) {
                            Swal.fire('Restored!', response.restored + ' users restored.', 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Error', 'Some users could not be restored.', 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Error', 'An error occurred while restoring users.', 'error');
                    }
                });
            }
        });
    }
    function viewEmployee(employeeId) {
        window.location.href = '/Employees/Details/' + employeeId;
    }
    // Enable Bootstrap tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
</script>
} 