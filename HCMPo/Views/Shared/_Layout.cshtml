        }
        
        .sidebar-nav .nav-item .nav-link i {
            width: 20px;
            margin-right: 12px;
            text-align: center;
            font-size: 1.1em;
        }
        
        .sidebar-nav .nav-item .nav-link span {
            flex: 1;
            font-weight: 500;
        }
        
        .sidebar-nav .nav-item .nav-link .badge {
            font-size: 0.7em;
            padding: 3px 6px;
            border-radius: 10px;
            margin-left: 8px;
        }
        
        .sidebar-nav .nav-item .nav-link.active .badge {
            background-color: rgba(255,255,255,0.2) !important;
            color: white;
        }
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            overflow-y: auto;
            max-height: 100vh;
            z-index: 1000;
            width: 280px;
            background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
            border-right: 1px solid #dee2e6;
            box-shadow: 2px 0 8px rgba(0,0,0,0.1);
        }
        
        .sidebar-header {
            padding: 20px;
            background: linear-gradient(135deg, #1976d2 0%, #1565c0 100%);
            color: white;
            text-align: center;
            border-bottom: 1px solid #dee2e6;
        }
        
        .sidebar-header h4 {
            margin: 10px 0 0 0;
            font-weight: 600;
            font-size: 1.2em;
        }
        
        .sidebar-header .logo {
            width: 40px;
            height: 40px;
            border-radius: 50%;
