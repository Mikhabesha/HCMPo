            font-weight: 600;
            color: #495057;
        }
        
        .sidebar-user .user-info small {
            color: #6c757d;
        }
        
        /* Main content adjustment for fixed sidebar */
        .main-content {
            margin-left: 280px;
        }
        
        /* Submenu styles */
        .has-submenu .submenu-toggle {
            position: relative;
        }
        
        .submenu-arrow {
            position: absolute;
            right: 15px;
            transition: transform 0.3s ease;
            font-size: 0.8em;
        }
        
        .submenu-toggle[aria-expanded="true"] .submenu-arrow {
            transform: rotate(180deg);
        }
        
        .submenu {
            list-style: none;
            padding: 0;
            margin: 0;
            background-color: rgba(0,0,0,0.05);
            border-left: 2px solid #e9ecef;
            margin-left: 15px;
            transition: all 0.3s ease;
            overflow: hidden;
            max-height: 0;
            opacity: 0;
        }
        
        .submenu.show {
            max-height: 500px;
            opacity: 1;
            padding: 5px 0;
        }
        
        .submenu li {
            margin: 0;
            transform: translateX(-20px);
            transition: transform 0.3s ease;
        }
        
        .submenu.show li {
            transform: translateX(0);
        }
        
        .submenu .nav-link {
            display: flex;
            align-items: center;
            padding: 8px 15px 8px 35px;
            font-size: 0.85em;
            color: #6c757d;
            border-left: 3px solid transparent;
            border-radius: 4px;
            margin: 1px 10px 1px 15px;
            transition: all 0.2s ease;
            text-decoration: none;
            position: relative;
        }
        
        .submenu .nav-link::before {
            content: '';
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            width: 4px;
            height: 4px;
            background-color: #dee2e6;
            border-radius: 50%;
            transition: all 0.2s ease;
        }
        
        .submenu .nav-link:hover {
            background-color: rgba(25,118,210,0.1);
            color: #1976d2;
            border-left-color: #1976d2;
            transform: translateX(5px);
        }
        
        .submenu .nav-link:hover::before {
            background-color: #1976d2;
            transform: translateY(-50%) scale(1.5);
        }
        
        .submenu .nav-link.active {
            background-color: rgba(25,118,210,0.15);
            color: #1976d2;
            border-left-color: #1976d2;
            font-weight: 600;
        }
        
        .submenu .nav-link.active::before {
            background-color: #1976d2;
            transform: translateY(-50%) scale(1.3);
        }
        
        .submenu .nav-link i {
            width: 16px;
            margin-right: 8px;
            font-size: 0.8em;
        }
        
        .submenu-divider {
            height: 1px;
            background-color: rgba(0,0,0,0.1);
            margin: 5px 20px;
        }
        
        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s ease;
            }
            
            .sidebar.show {
                transform: translateX(0);
            }
            
            .main-content {
                margin-left: 0;
            }
            
            body.sidebar-collapsed .sidebar {
                transform: translateX(0);
            }
        }
        
        /* Improved sidebar scrolling */
        .sidebar-nav {
            padding-bottom: 100px; /* Add space at bottom */
        }
    </style>
