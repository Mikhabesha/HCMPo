@using HCMPo
@using HCMPo.Models
@using Microsoft.AspNetCore.Identity
@using HCMPo.Helpers
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HCM Portal</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome-cdn/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ethiopian-datepicker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/payrollreport.css" />
    <link rel="stylesheet" href="~/css/payrollslip.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Page Loader -->
    <div id="pageLoader" class="page-loader">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <img src="~/images/logo.jpg" alt="Logo" class="logo" />
            <h4>HCM Portal</h4>
        </div>
        <div class="sidebar-user">
            @if (User.Identity.IsAuthenticated)
            {
                @await Component.InvokeAsync("UserProfilePhoto", new { a_class = "rounded-circle mb-2", size = 80 })
                <div class="user-info">
                    <h6>@User.Identity.Name</h6>
                    <small>@User.Claims.FirstOrDefault(c => c.Type == "JobTitle")?.Value</small>
                </div>
            }
        </div>
        <nav class="sidebar-nav">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Home" ? "active" : "")" 
                       asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                
                @if (User.IsInRole("HR") || User.IsInRole("Admin"))
                {
                    <!-- Employee Management Section -->
                    <li class="nav-item has-submenu">
                        <a class="nav-link submenu-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "Employees" ? "active" : "")" 
                           href="#" data-bs-toggle="collapse" data-bs-target="#employeeSubmenu" aria-expanded="false">
                            <i class="fas fa-users"></i>
                            <span>Employee Management</span>
                            <i class="fas fa-chevron-down submenu-arrow"></i>
                        </a>
                        <div class="collapse @(ViewContext.RouteData.Values["Controller"].ToString() == "Employees" ? "show" : "")" id="employeeSubmenu">
                            <ul class="submenu">
                                <li><a class="nav-link" asp-controller="Employees" asp-action="Index"><i class="fas fa-list"></i> All Employees</a></li>
                                <li><a class="nav-link" asp-controller="Employees" asp-action="Create"><i class="fas fa-user-plus"></i> Add Employee</a></li>
                                <li><a class="nav-link" asp-controller="EmployeeDocuments" asp-action="Index"><i class="fas fa-file-alt"></i> Documents</a></li>
                            </ul>
                        </div>
                    </li>

                    <!-- Attendance Section -->
                    <li class="nav-item has-submenu">
                        <a class="nav-link submenu-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "Attendances" ? "active" : "")" 
                           href="#" data-bs-toggle="collapse" data-bs-target="#attendanceSubmenu" aria-expanded="false">
                            <i class="fas fa-clock"></i>
                            <span>Attendance</span>
                            <i class="fas fa-chevron-down submenu-arrow"></i>
                        </a>
                        <div class="collapse @(ViewContext.RouteData.Values["Controller"].ToString() == "Attendances" ? "show" : "")" id="attendanceSubmenu">
                            <ul class="submenu">
                                <li><a class="nav-link" asp-controller="Attendances" asp-action="Index"><i class="fas fa-list-ul"></i> Attendance Log</a></li>
                                <li><a class="nav-link" asp-controller="Attendances" asp-action="Summary"><i class="fas fa-chart-pie"></i> Summary Report</a></li>
                                <li><a class="nav-link" asp-controller="Attendances" asp-action="Create"><i class="fas fa-plus"></i> Manual Entry</a></li>
                            </ul>
                        </div>
                    </li>

                    <!-- Payroll Section -->
                    <li class="nav-item has-submenu">
                        <a class="nav-link submenu-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "Payroll" || ViewContext.RouteData.Values["Controller"].ToString() == "PayrollSlip" ? "active" : "")" 
                           href="#" data-bs-toggle="collapse" data-bs-target="#payrollSubmenu" aria-expanded="false">
                            <i class="fas fa-money-bill-wave"></i>
                            <span>Payroll</span>
                            <i class="fas fa-chevron-down submenu-arrow"></i>
                        </a>
                        <div class="collapse @(ViewContext.RouteData.Values["Controller"].ToString() == "Payroll" || ViewContext.RouteData.Values["Controller"].ToString() == "PayrollSlip" ? "show" : "")" id="payrollSubmenu">
                            <ul class="submenu">
                                <li><a class="nav-link" asp-controller="Payroll" asp-action="Index"><i class="fas fa-history"></i> Payroll History</a></li>
                                <li><a class="nav-link" asp-controller="Payroll" asp-action="Declarations"><i class="fas fa-file-invoice"></i> Declarations</a></li>
                                <li class="submenu-divider"></li>
                                <li><a class="nav-link" asp-controller="PayrollSlip" asp-action="Index"><i class="fas fa-file-invoice-dollar"></i> Payroll Slips</a></li>
                                <li><a class="nav-link" asp-controller="PayrollSlip" asp-action="Summary"><i class="fas fa-chart-bar"></i> Slip Summary</a></li>
                                @if (User.IsInRole("HR") || User.IsInRole("Admin"))
                                {
                                    <li><a class="nav-link" asp-controller="PayrollSlip" asp-action="StampManagement"><i class="fas fa-stamp"></i> Manage Stamps</a></li>
                                }
                                <li class="submenu-divider"></li>
                                <li><a class="nav-link" asp-controller="AllowanceTypes" asp-action="Index"><i class="fas fa-plus-circle"></i> Allowance Types</a></li>
                                <li><a class="nav-link" asp-controller="DeductionTypes" asp-action="Index"><i class="fas fa-minus-circle"></i> Deduction Types</a></li>
                            </ul>
                        </div>
                    </li>
                }

                <!-- Leave Management Section (Available to All Users) -->
                <li class="nav-item has-submenu">
                    <a class="nav-link submenu-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "LeaveRequests" || ViewContext.RouteData.Values["Controller"].ToString() == "Leave" ? "active" : "")" 
                       href="#" data-bs-toggle="collapse" data-bs-target="#leaveSubmenu" aria-expanded="false">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Leave Management</span>
                        @if (ViewBag.PendingLeaveCount > 0)
                        {
                            <span class="badge bg-warning">@ViewBag.PendingLeaveCount</span>
                        }
                        <i class="fas fa-chevron-down submenu-arrow"></i>
                    </a>
                    <div class="collapse @(ViewContext.RouteData.Values["Controller"].ToString() == "LeaveRequests" || ViewContext.RouteData.Values["Controller"].ToString() == "Leave" ? "show" : "")" id="leaveSubmenu">
                        <ul class="submenu">
                            <li><a class="nav-link" asp-controller="LeaveRequests" asp-action="Index"><i class="fas fa-list"></i> My Leave Requests</a></li>
                            <li><a class="nav-link" asp-controller="LeaveRequests" asp-action="Create"><i class="fas fa-plus"></i> Request Leave</a></li>
                            <li><a class="nav-link" asp-controller="LeaveRequests" asp-action="MyBalance"><i class="fas fa-chart-pie"></i> My Leave Balance</a></li>
                            <li><a class="nav-link" asp-controller="LeaveRequests" asp-action="Calendar"><i class="fas fa-calendar"></i> Leave Calendar</a></li>
                            @if (User.IsInRole("HR") || User.IsInRole("Admin"))
                            {
                                <li class="submenu-divider"></li>
                                <li><a class="nav-link" asp-controller="LeaveRequests" asp-action="ManageEntitlements"><i class="fas fa-user-cog"></i> Manage Entitlements</a></li>
                                <li><a class="nav-link" asp-controller="LeaveRequests" asp-action="ManageCarryovers"><i class="fas fa-exchange-alt"></i> Manage Carryovers</a></li>
                                <li><a class="nav-link" asp-controller="LeaveRequests" asp-action="Reports"><i class="fas fa-chart-bar"></i> Leave Reports</a></li>
                            }
                        </ul>
                    </div>
                </li>

                @if (User.IsInRole("HR") || User.IsInRole("Admin"))
                {
                    <!-- Configuration Section -->
                    <li class="nav-item mt-3">
                        <span class="sidebar-section-header">Configuration</span>
                    </li>
                    <li class="nav-item has-submenu">
                        <a class="nav-link submenu-toggle" href="#" data-bs-toggle="collapse" data-bs-target="#configSubmenu" aria-expanded="false">
                            <i class="fas fa-cogs"></i>
                            <span>System Settings</span>
                            <i class="fas fa-chevron-down submenu-arrow"></i>
                        </a>
                        <div class="collapse" id="configSubmenu">
                            <ul class="submenu">
                                <li><a class="nav-link" asp-controller="PayrollConfiguration" asp-action="Index"><i class="fas fa-calculator"></i> Payroll Config</a></li>
                                <li><a class="nav-link" asp-controller="TaxSettings" asp-action="Index"><i class="fas fa-balance-scale"></i> Tax Settings</a></li>
                                <li><a class="nav-link" asp-controller="UserManagement" asp-action="Index"><i class="fas fa-users-cog"></i> User Management</a></li>
                                <li><a class="nav-link" asp-controller="EmployeeManagement" asp-action="Index"><i class="fas fa-users"></i> Employee Management</a></li>
                            </ul>
                        </div>
                    </li>

                    <!-- Reports Section -->
                    <li class="nav-item mt-3">
                        <span class="sidebar-section-header">Reports</span>
                    </li>
                    <li class="nav-item has-submenu">
                        <a class="nav-link submenu-toggle" href="#" data-bs-toggle="collapse" data-bs-target="#reportsSubmenu" aria-expanded="false">
                            <i class="fas fa-chart-line"></i>
                            <span>Reports</span>
                            <i class="fas fa-chevron-down submenu-arrow"></i>
                        </a>
                        <div class="collapse" id="reportsSubmenu">
                            <ul class="submenu">
                                <li><a class="nav-link" asp-controller="PayrollReport" asp-action="Index"><i class="fas fa-file-invoice-dollar"></i> Payroll Reports</a></li>
                                <li><a class="nav-link" asp-controller="LeaveRequests" asp-action="Reports"><i class="fas fa-calendar-check"></i> Leave Reports</a></li>
                                <li><a class="nav-link" asp-controller="Attendances" asp-action="Summary"><i class="fas fa-clock"></i> Attendance Reports</a></li>
                            </ul>
                        </div>
                    </li>
                }

                <li class="nav-item has-submenu">
                    <a class="nav-link submenu-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "OrganizationUnit" || ViewContext.RouteData.Values["Controller"].ToString() == "JobTitles" ? "active" : "")" 
                       href="#" data-bs-toggle="collapse" data-bs-target="#orgConfigSubmenu" aria-expanded="false">
                        <i class="fas fa-sitemap"></i>
                        <span>Org Configuration</span>
                        <i class="fas fa-chevron-down submenu-arrow"></i>
                    </a>
                    <div class="collapse @(ViewContext.RouteData.Values["Controller"].ToString() == "OrganizationUnit" || ViewContext.RouteData.Values["Controller"].ToString() == "JobTitles" ? "show" : "")" id="orgConfigSubmenu">
                        <ul class="submenu">
                            <li><a class="nav-link" asp-controller="OrganizationUnit" asp-action="Index"><i class="fas fa-building"></i> Organization Units</a></li>
                            <li><a class="nav-link" asp-controller="JobTitles" asp-action="Index"><i class="fas fa-user-tie"></i> Job Titles</a></li>
                        </ul>
                    </div>
                </li>
            </ul>
        </nav>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container-fluid">
                <button class="btn btn-link sidebar-toggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="navbar-nav ms-auto">
                    <div class="d-flex align-items-center">
                        <!-- Notifications Dropdown -->
                    <div class="nav-item dropdown">
                            <a class="nav-link text-dark" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-bell"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notification-badge" style="display: none;"></span>
                        </a>
                            <div class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="notificationDropdown" id="notification-dropdown-menu">
                            @await Component.InvokeAsync("NotificationsDropdown")
                        </div>
                    </div>

                        <!-- Profile Dropdown -->
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" 
                           data-bs-toggle="dropdown" aria-expanded="false">
                                @await Component.InvokeAsync("UserProfilePhoto", new { a_class = "rounded-circle me-2", size = 32 })
                        </a>
                        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                <i class="fas fa-user"></i> Profile
                            </a>
                            <a class="dropdown-item" asp-controller="Profile" asp-action="Settings">
                                <i class="fas fa-cog"></i> Settings
                            </a>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item">
                                    <i class="fas fa-sign-out-alt"></i> Logout
                                </button>
                            </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Page Content -->
        <div class="container-fluid py-4 content-scroll-area">
            @RenderBody()
        </div>
    </div>

    <!-- Sticky Footer -->
    <footer class="footer mt-auto py-3 bg-light border-top">
        <div class="container text-center">
            <span class="text-muted">&copy; @DateTime.Now.Year HCM Portal. All rights reserved.</span>
            <span class="text-muted ms-2">| @DateTime.Now.ToString("MMM dd, yyyy") <small class="text-muted">(@EthiopianCalendarHelper.FormatEthiopianShort(DateTime.Now))</small></span>
            <span class="footer-links ms-3">
                <!-- Add your future footer links here -->
                <a href="#" class="text-muted me-2">Privacy Policy</a>
                <a href="#" class="text-muted">Contact</a>
            </span>
        </div>
    </footer>

    <!-- Task Spinner -->
    <div id="taskSpinner" class="task-spinner">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/lib/font-awesome/js/all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/signalr/dist/browser/signalr.min.js"></script>
    @RenderSection("Scripts", required: false)

    <script>
        // Page loader
        $(window).on('load', function() {
            $('#pageLoader').fadeOut('slow');
        });

        // Task spinner
        function showTaskSpinner() {
            $('#taskSpinner').fadeIn('fast');
        }

        function hideTaskSpinner() {
            $('#taskSpinner').fadeOut('fast');
        }

        // Sidebar toggle
        $('.sidebar-toggle').click(function() {
            $('body').toggleClass('sidebar-collapsed');
            $('.sidebar').toggleClass('show');
        });

        // Enhanced submenu toggle functionality with animations
        $('.submenu-toggle').click(function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            var target = $(this).attr('data-bs-target');
            var $target = $(target);
            var $submenu = $target.find('.submenu');
            var $arrow = $(this).find('.submenu-arrow');
            var isCurrentlyOpen = $submenu.hasClass('show');
            
            // Close all other submenus first
            $('.collapse .submenu').not($submenu).removeClass('show');
            $('.submenu-toggle').not(this).attr('aria-expanded', 'false');
            $('.submenu-arrow').not($arrow).css('transform', 'rotate(0deg)');
            
            // Toggle current submenu with enhanced animation
            if (isCurrentlyOpen) {
                $submenu.removeClass('show');
                $(this).attr('aria-expanded', 'false');
                $arrow.css('transform', 'rotate(0deg)');
            } else {
                $submenu.addClass('show');
                $(this).attr('aria-expanded', 'true');
                $arrow.css('transform', 'rotate(180deg)');
                
                // Animate submenu items with staggered delay
                $submenu.find('li').each(function(index) {
                    var $item = $(this);
                    setTimeout(function() {
                        $item.css('transform', 'translateX(0)');
                    }, index * 50);
                });
            }
        });

        // Prevent submenu collapse when clicking submenu items
        $('.submenu .nav-link').click(function(e) {
            e.stopPropagation();
            
            // Store the current submenu state in localStorage to preserve it
            var $submenu = $(this).closest('.submenu');
            var $collapse = $submenu.closest('.collapse');
            var submenuId = $collapse.attr('id');
            
            if (submenuId) {
                localStorage.setItem('openSubmenu', submenuId);
            }
        });

        // Auto-expand submenus if current page is in submenu or restore from localStorage
        $(document).ready(function() {
            var openSubmenuId = localStorage.getItem('openSubmenu');
            var hasActiveSubmenuLink = false;
            
            // First check if current page has an active submenu link
            $('.submenu .nav-link').each(function() {
                if ($(this).hasClass('active')) {
                    var $submenuList = $(this).closest('.submenu');
                    var $collapse = $submenuList.closest('.collapse');
                    var $toggle = $('[data-bs-target="#' + $collapse.attr('id') + '"]');
                    
                    $submenuList.addClass('show');
                    $toggle.attr('aria-expanded', 'true');
                    $toggle.find('.submenu-arrow').css('transform', 'rotate(180deg)');
                    hasActiveSubmenuLink = true;
                    
                    // Update localStorage with current active submenu
                    localStorage.setItem('openSubmenu', $collapse.attr('id'));
                }
            });
            
            // If no active submenu link but we have a stored submenu, restore it
            if (!hasActiveSubmenuLink && openSubmenuId) {
                var $storedCollapse = $('#' + openSubmenuId);
                if ($storedCollapse.length) {
                    var $storedSubmenu = $storedCollapse.find('.submenu');
                    var $storedToggle = $('[data-bs-target="#' + openSubmenuId + '"]');
                    
                    $storedSubmenu.addClass('show');
                    $storedCollapse.addClass('show').collapse('show');
                    $storedToggle.attr('aria-expanded', 'true');
                    $storedToggle.find('.submenu-arrow').css('transform', 'rotate(180deg)');
                }
            }
        });

        // Add loading indicator to forms
        $('form').submit(function() {
            showTaskSpinner();
        });

        // Add loading indicator to links (but not submenu toggles)
        $('a:not([data-bs-toggle]):not(.submenu-toggle)').click(function() {
            if ($(this).attr('href') !== '#') {
                showTaskSpinner();
            }
        });

        // Mobile sidebar handling
        $(document).click(function(e) {
            if ($(window).width() <= 768) {
                if (!$(e.target).closest('.sidebar, .sidebar-toggle').length) {
                    $('.sidebar').removeClass('show');
                    $('body').removeClass('sidebar-collapsed');
                }
            }
        });

        function adjustEthiopianDayDropdown(yearSelector, monthSelector, daySelector) {
            var year = parseInt($(yearSelector).val(), 10) || 0;
            var month = parseInt($(monthSelector).val(), 10) || 0;
            var maxDay = 30;
            if (month === 13) {
                // Ethiopian leap year: (year % 4) == 3
                maxDay = (year % 4 === 3) ? 6 : 5;
            }
            var selectedDay = parseInt($(daySelector).val(), 10) || 0;

            $(daySelector).empty();
            $(daySelector).append('<option value="">ቀን ይምረጡ</option>');
            for (var d = 1; d <= maxDay; d++) {
                var selected = (d === selectedDay && selectedDay <= maxDay) ? 'selected' : '';
                $(daySelector).append('<option value="' + d + '" ' + selected + '>' + d + '</option>');
            }
            if (selectedDay > maxDay) {
                $(daySelector).val('');
            }
        }

        $(document).ready(function() {
            $('.ethiopian-date-picker').each(function() {
                var picker = $(this);
                var yearSel = picker.find('.eth-year');
                var monthSel = picker.find('.eth-month');
                var daySel = picker.find('.eth-day');

                function updateDays() {
                    adjustEthiopianDayDropdown(yearSel, monthSel, daySel);
                }

                monthSel.on('change', updateDays);
                yearSel.on('change', updateDays);

                // Initialize on page load
                updateDays();
            });
        });

        $(document).ready(function () {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .build();

            async function start() {
                try {
                    await connection.start();
                    console.log("SignalR Connected.");
                    updateNotificationCount();
                } catch (err) {
                    console.log(err);
                    setTimeout(start, 5000);
                }
            };

            connection.onclose(async () => {
                await start();
            });

            // Listen for notification count updates
            connection.on("UpdateBadgeCount", function (count, type) {
                updateBadge(count, type);
            });

            // Listen for new notifications to refresh dropdown
            connection.on("ReceiveNotification", function(message) {
                // Refresh the dropdown content
                $('#notification-dropdown-menu').load('/Profile/NotificationsDropdown');
                updateNotificationCount(); 
            });

            function updateNotificationCount() {
                $.get('/Profile/GetUnreadNotificationSummary', function (data) {
                    updateBadge(data.count, data.type);
                });
            }

            function updateBadge(count, type) {
                const badge = $('#notification-badge');
                if (count > 0) {
                    badge.text(count).show();
                } else {
                    badge.hide();
                }

                // Reset badge color
                badge.removeClass('bg-danger bg-success bg-warning bg-info bg-primary');

                // Set new badge color based on the type of the most recent notification
                switch (type) {
                    case 'Leave':
                        badge.addClass('bg-success'); // Green for leave
                        break;
                    case 'Payroll':
                        badge.addClass('bg-primary'); // Blue for payroll
                        break;
                    case 'Attendance':
                        badge.addClass('bg-warning'); // Yellow for attendance
                        break;
                    case 'System':
                        badge.addClass('bg-danger'); // Red for system alerts
                        break;
                    default: // 'Info' and any other types
                        badge.addClass('bg-info'); // Default to info blue
                        break;
                }
            }
            
            // Initial load
            start();
        });
    </script>

    <style>
        html, body {
            height: 100%;
        }
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .main-content {
            flex: 1 0 auto;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }
        .content-scroll-area {
            flex: 1 1 auto;
            overflow-y: auto;
            min-height: 0;
        }
        .footer {
            flex-shrink: 0;
            margin-top: auto;
            width: 100%;
            background-color: #f8f9fa;
            border-top: 1px solid #dee2e6;
        }
        .footer-links a {
            text-decoration: none;
        }
        .sidebar-section-header {
            font-size: 0.85rem;
            font-weight: 600;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            margin: 15px 20px 8px 20px;
            padding: 8px 0;
            border-bottom: 1px solid #e9ecef;
            position: relative;
        }
        
        .sidebar-section-header::before {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 30px;
            height: 2px;
            background: linear-gradient(90deg, #1976d2, #42a5f5);
            border-radius: 1px;
