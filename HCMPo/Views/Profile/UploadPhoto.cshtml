@model HCMPo.Controllers.PhotoUploadViewModel
@{
    ViewData["Title"] = "Upload Profile Photo";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-camera text-primary"></i> Upload Profile Photo</h2>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Profile
                </a>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-upload"></i> Upload Your Profile Photo
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" id="photoUploadForm">
                        <input type="hidden" asp-for="EmployeeId" />
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <label asp-for="PhotoFile" class="form-label fw-bold">Select Photo</label>
                                    <input asp-for="PhotoFile" type="file" class="form-control" accept="image/*" id="photoFile" />
                                    <span asp-validation-for="PhotoFile" class="text-danger"></span>
                                    <div class="form-text">
                                        <i class="fas fa-info-circle"></i> 
                                        Supported formats: JPG, PNG, GIF (Max size: 5MB)
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <button type="submit" class="btn btn-primary" id="uploadBtn">
                                        <i class="fas fa-upload"></i> Upload Photo
                                    </button>
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <i class="fas fa-times"></i> Cancel
                                    </a>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-center">
                                    <div class="mb-3">
                                        <h6 class="text-muted">Photo Preview</h6>
                                        <div id="photoPreview" class="border rounded p-3" style="min-height: 200px; display: flex; align-items: center; justify-content: center;">
                                            <div class="text-muted">
                                                <i class="fas fa-image fa-3x mb-2"></i>
                                                <br>Select a photo to preview
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Photo Guidelines -->
            <div class="card mt-4">
                <div class="card-header bg-info text-white">
                    <h6 class="card-title mb-0">
                        <i class="fas fa-info-circle"></i> Photo Guidelines
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-success">✅ Recommended:</h6>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-check text-success"></i> Professional headshot</li>
                                <li><i class="fas fa-check text-success"></i> Clear, well-lit photo</li>
                                <li><i class="fas fa-check text-success"></i> Neutral background</li>
                                <li><i class="fas fa-check text-success"></i> Square aspect ratio</li>
                                <li><i class="fas fa-check text-success"></i> High resolution (at least 200x200px)</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-danger">❌ Avoid:</h6>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-times text-danger"></i> Group photos</li>
                                <li><i class="fas fa-times text-danger"></i> Blurry or dark images</li>
                                <li><i class="fas fa-times text-danger"></i> Inappropriate content</li>
                                <li><i class="fas fa-times text-danger"></i> Very large file sizes</li>
                                <li><i class="fas fa-times text-danger"></i> Non-image files</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Photo preview functionality
            $('#photoFile').change(function() {
                const file = this.files[0];
                const preview = $('#photoPreview');
                
                if (file) {
                    // Validate file type
                    const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                    if (!allowedTypes.includes(file.type)) {
                        alert('Please select a valid image file (JPG, PNG, or GIF)');
                        this.value = '';
                        preview.html(`
                            <div class="text-muted">
                                <i class="fas fa-image fa-3x mb-2"></i>
                                <br>Select a photo to preview
                            </div>
                        `);
                        return;
                    }
                    
                    // Validate file size (5MB)
                    if (file.size > 5 * 1024 * 1024) {
                        alert('File size must be less than 5MB');
                        this.value = '';
                        preview.html(`
                            <div class="text-muted">
                                <i class="fas fa-image fa-3x mb-2"></i>
                                <br>Select a photo to preview
                            </div>
                        `);
                        return;
                    }
                    
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        preview.html(`
                            <img src="${e.target.result}" alt="Preview" class="img-fluid rounded" style="max-height: 200px; max-width: 100%;">
                        `);
                    };
                    reader.readAsDataURL(file);
                } else {
                    preview.html(`
                        <div class="text-muted">
                            <i class="fas fa-image fa-3x mb-2"></i>
                            <br>Select a photo to preview
                        </div>
                    `);
                }
            });
            
            // Form submission
            $('#photoUploadForm').submit(function(e) {
                console.log('Form submission started');
                
                const file = $('#photoFile')[0].files[0];
                if (!file) {
                    alert('Please select a photo to upload');
                    e.preventDefault();
                    return false;
                }
                
                console.log('File selected:', file.name, 'Size:', file.size, 'Type:', file.type);
                
                // Show loading
                $('#uploadBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Uploading...');
                
                console.log('Form will submit to:', this.action);
                return true;
            });
        });
    </script>
} 