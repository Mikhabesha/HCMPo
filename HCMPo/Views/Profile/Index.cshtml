@model HCMPo.Controllers.ProfileViewModel
@using HCMPo.Helpers

@{
    ViewData["Title"] = "My Profile";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-user-circle text-primary"></i> My Profile</h2>
                <div>
                    <a asp-action="Settings" class="btn btn-outline-primary">
                        <i class="fas fa-cog"></i> Settings
                    </a>
                    <a asp-action="Notifications" class="btn btn-outline-info">
                        <i class="fas fa-bell"></i> Notifications
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- User Information Card -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user"></i> User Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 text-center mb-3">
                            <div class="profile-avatar">
                                @if (!string.IsNullOrEmpty(Model.Employee?.PhotoUrl))
                                {
                                    <img src="~/@Model.Employee.PhotoUrl" alt="Profile Photo" class="img-fluid rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="fas fa-user-circle fa-4x text-primary"></i>
                                }
                            </div>
                            @if (Model.Employee != null)
                            {
                                <div class="mt-2">
                                    <a asp-action="UploadPhoto" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-camera"></i> Upload Photo
                                    </a>
                                    @if (!string.IsNullOrEmpty(Model.Employee.PhotoUrl))
                                    {
                                        <a asp-action="ViewPhoto" class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-eye"></i> View Photos
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Username:</label>
                                <p class="form-control-plaintext">@Model.UserName</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Email:</label>
                                <p class="form-control-plaintext">@Model.Email</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Phone Number:</label>
                                <p class="form-control-plaintext">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Notification Preferences Card -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-bell"></i> Notification Preferences
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="leaveNotifications" 
                                   @(Model.LeaveRequestAlerts ? "checked" : "") disabled>
                            <label class="form-check-label" for="leaveNotifications">
                                Leave Request Alerts
                            </label>
                        </div>
                        <small class="text-muted">Receive notifications for leave requests and approvals</small>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="payrollAlerts" 
                                   @(Model.PayrollAlerts ? "checked" : "") disabled>
                            <label class="form-check-label" for="payrollAlerts">
                                Payroll Alerts
                            </label>
                        </div>
                        <small class="text-muted">Receive notifications for payroll and salary updates</small>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="attendanceAlerts" 
                                   @(Model.AttendanceAlerts ? "checked" : "") disabled>
                            <label class="form-check-label" for="attendanceAlerts">
                                Attendance Alerts
                            </label>
                        </div>
                        <small class="text-muted">Receive alerts for attendance issues</small>
                    </div>
                    <div class="mt-3">
                        <a asp-action="Settings" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit"></i> Edit Preferences
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Employee != null)
    {
        <div class="row">
            <!-- Employee Information Card -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-id-badge"></i> Employee Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Full Name:</label>
                                    <p class="form-control-plaintext">@Model.Employee.FullName</p>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Badge Number:</label>
                                    <p class="form-control-plaintext">@Model.Employee.BadgeNumber</p>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Job Title:</label>
                                    <p class="form-control-plaintext">@Model.Employee.JobTitle?.Title</p>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Department:</label>
                                    <p class="form-control-plaintext">@Model.Employee.OrganizationUnit?.Name</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Hire Date:</label>
                                    <p class="form-control-plaintext">@Html.Raw(EthiopianCalendarHelper.FormatDateWithEthiopian(Model.Employee.HireDate))</p>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Status:</label>
                                    <span class="badge @(Model.Employee.IsActive ? "bg-success" : "bg-danger")">
                                        @(Model.Employee.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Basic Salary:</label>
                                    <p class="form-control-plaintext">@Model.Employee.BasicSalary.ToString("C")</p>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Employee ID:</label>
                                    <p class="form-control-plaintext">@Model.Employee.Id</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-user-slash fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Employee Profile Linked</h5>
                        <p class="text-muted">Your user account is not linked to an employee profile.</p>
                        <p class="text-muted">Contact your HR administrator if you believe this is an error.</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Add any profile-specific JavaScript here
        });
    </script>
} 