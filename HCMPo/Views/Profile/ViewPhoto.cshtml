@model HCMPo.Models.Employee
@{
    ViewData["Title"] = "Profile Photos";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-images text-primary"></i> Profile Photos</h2>
                <div>
                    <a asp-action="UploadPhoto" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Upload New Photo
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Profile
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user"></i> Photos for @Model.FullName
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Documents?.Any() == true)
                    {
                        <div class="row">
                            @foreach (var document in Model.Documents.OrderByDescending(d => d.UploadDate))
                            {
                                <div class="col-md-4 col-lg-3 mb-4">
                                    <div class="card photo-card h-100">
                                        <div class="card-body text-center p-3">
                                            <img src="~/@document.FilePath" alt="Profile Photo" 
                                                 class="img-fluid rounded mb-3" style="max-height: 200px; width: 100%; object-fit: cover;" />
                                            
                                            <div class="mb-2">
                                                <small class="text-muted">
                                                    <i class="fas fa-calendar"></i> 
                                                    @document.UploadDate.ToString("MMM dd, yyyy")
                                                </small>
                                            </div>
                                            
                                            <div class="mb-2">
                                                <small class="text-muted">
                                                    <i class="fas fa-user"></i> 
                                                    @document.UploadedBy
                                                </small>
                                            </div>
                                            
                                            @if (Model.PhotoUrl == document.FilePath)
                                            {
                                                <div class="mb-2">
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check"></i> Current Photo
                                                    </span>
                                                </div>
                                            }
                                            
                                            <div class="btn-group btn-group-sm w-100">
                                                <a href="~/@document.FilePath" target="_blank" class="btn btn-outline-info">
                                                    <i class="fas fa-eye"></i> View
                                                </a>
                                                <button type="button" class="btn btn-outline-danger" 
                                                        onclick="deletePhoto('@document.Id', '@document.FileName')">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-images fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Photos Uploaded</h5>
                            <p class="text-muted">You haven't uploaded any profile photos yet.</p>
                            <a asp-action="UploadPhoto" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Upload Your First Photo
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deletePhoto(documentId, fileName) {
            if (confirm(`Are you sure you want to delete the photo "${fileName}"?`)) {
                $.post('@Url.Action("DeletePhoto", "Profile")', {
                    documentId: documentId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                })
                .done(function(response) {
                    if (response.success) {
                        showAlert(response.message, 'success');
                        // Reload the page to refresh the photo list
                        setTimeout(function() {
                            location.reload();
                        }, 1500);
                    } else {
                        showAlert(response.message, 'danger');
                    }
                })
                .fail(function() {
                    showAlert('An error occurred while deleting the photo', 'danger');
                });
            }
        }

        function showAlert(message, type) {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('.container-fluid').prepend(alertHtml);
            
            setTimeout(function() {
                $('.alert').alert('close');
            }, 5000);
        }
    </script>
}

<style>
    .photo-card {
        transition: all 0.3s ease;
        border: 1px solid #e3e6f0;
    }
    
    .photo-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    
    .photo-card img {
        transition: all 0.3s ease;
    }
    
    .photo-card:hover img {
        transform: scale(1.05);
    }
</style> 