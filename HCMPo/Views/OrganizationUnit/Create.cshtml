@model HCMPo.Models.OrganizationUnit
@{
    ViewData["Title"] = "Create Organization Unit";
}
<h2>Create Organization Unit</h2>
<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" class="form-select">
            @foreach (var type in Enum.GetValues(typeof(HCMPo.Models.OrganizationUnitType)))
            {
                <option value="@type">@type</option>
            }
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ParentId" class="form-label">Parent Unit</label>
        <select asp-for="ParentId" class="form-select">
            <option value="">-- None --</option>
            @foreach (var unit in ViewBag.AllUnits as List<HCMPo.Models.OrganizationUnit> ?? new List<HCMPo.Models.OrganizationUnit>())
            {
                <option value="@unit.Id">@unit.Name</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="IsActive" class="form-label"></label>
        <input asp-for="IsActive" type="checkbox" class="form-check-input" />
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form> 