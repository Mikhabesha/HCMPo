@model HCMPo.Models.Employee
@using HCMPo.Helpers

@{
    ViewData["Title"] = $"Employee Details - {Model.FullName}";
}

<div class="container-fluid px-2 px-md-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0"><i class="fas fa-id-badge me-2"></i>Employee Details - @Model.FullName</h2>
        <div>
            <a asp-action="Index" class="btn btn-secondary me-2"><i class="fas fa-arrow-left me-1"></i>Back to List</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2"><i class="fas fa-edit me-1"></i>Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"><i class="fas fa-trash me-1"></i>Delete</a>
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 d-flex flex-column align-items-center justify-content-center">
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mb-2" style="width: 120px; height: 120px; font-size: 4rem;">
                        <i class="fas fa-user"></i>
                    </div>
                    <h4 class="fw-bold mb-0">@Model.FullName</h4>
                    <div class="text-muted">Badge: @Model.BadgeNumber</div>
                </div>
                <div class="col-md-9">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary mb-2"><i class="fas fa-user me-1"></i>Personal Information</h5>
                            <dl class="row mb-0">
                                <dt class="col-sm-5">First Name:</dt>
                                <dd class="col-sm-7">@Model.FirstName</dd>
                                <dt class="col-sm-5">Last Name:</dt>
                                <dd class="col-sm-7">@Model.LastName</dd>
                                <dt class="col-sm-5">Email:</dt>
                                <dd class="col-sm-7"><a href="mailto:@Model.Email">@Model.Email</a></dd>
                                <dt class="col-sm-5">Phone:</dt>
                                <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)</dd>
                                <dt class="col-sm-5">Gender:</dt>
                                <dd class="col-sm-7">@Model.Gender</dd>
                                <dt class="col-sm-5">Date of Birth:</dt>
                                <dd class="col-sm-7">@Html.Raw(EthiopianCalendarHelper.FormatDateWithEthiopian(Model.DateOfBirth))</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-primary mb-2"><i class="fas fa-briefcase me-1"></i>Employment Information</h5>
                            <dl class="row mb-0">
                                <dt class="col-sm-6">Badge Number:</dt>
                                <dd class="col-sm-6">@Model.BadgeNumber</dd>
                                <dt class="col-sm-6">Organization Unit:</dt>
                                <dd class="col-sm-6">@Model.OrganizationUnit?.Name</dd>
                                <dt class="col-sm-6">Job Title:</dt>
                                <dd class="col-sm-6">@Model.JobTitle?.Title</dd>
                                <dt class="col-sm-6">Position:</dt>
                                <dd class="col-sm-6">@Model.Position</dd>
                                <dt class="col-sm-6">Hire Date:</dt>
                                <dd class="col-sm-6">@Html.Raw(EthiopianCalendarHelper.FormatDateWithEthiopian(Model.HireDate))</dd>
                                <dt class="col-sm-6">Employment Date:</dt>
                                <dd class="col-sm-6">@Html.Raw(EthiopianCalendarHelper.FormatDateWithEthiopian(Model.EmploymentDate))</dd>
                                <dt class="col-sm-6">Basic Salary:</dt>
                                <dd class="col-sm-6">@Model.BasicSalary.ToString("C0")</dd>
                                <dt class="col-sm-6">Status:</dt>
                                <dd class="col-sm-6">@Model.Status</dd>
                            </dl>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <h6 class="text-primary"><i class="fas fa-info-circle me-1"></i>Additional Information</h6>
                            <div class="mb-2">@Model.Address</div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-primary"><i class="fas fa-history me-1"></i>Audit Information</h6>
                            <div class="mb-1"><strong>Created:</strong> @Html.Raw(EthiopianCalendarHelper.FormatDateWithEthiopian(Model.CreatedAt, "MMM dd, yyyy HH:mm"))</div>
                            <div class="mb-1"><strong>Is Active:</strong> @(Model.IsActive ? "Yes" : "No")</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-12">
                    @if (Model.ApplicationUserId == null)
                    {
                        <div class="alert alert-warning d-flex align-items-center mb-2" role="alert">
                            <i class="fas fa-user-slash me-2"></i> No User Account
                        </div>
                        <button class="btn btn-primary" id="createUserAccountBtn"><i class="fas fa-user-plus me-1"></i>Create User Account</button>
                    }
                    else
                    {
                        <div class="alert alert-success d-flex align-items-center mb-2" role="alert">
                            <i class="fas fa-user-check me-2"></i>
                            User Account:
                            <strong class="ms-1">@ViewBag.UserEmail</strong>
                            <span class="ms-3">Username: <strong>@ViewBag.UserName</strong></span>
                            <span class="ms-3">Roles: <strong>@string.Join(", ", (IEnumerable<string>)ViewBag.UserRoles ?? new List<string>())</strong></span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="mb-3"><i class="fas fa-bolt me-1"></i>Quick Actions</h5>
            <div class="row g-2">
                <div class="col-md-3">
                    <a href="/Attendances?employeeId=@Model.Id" class="btn btn-info w-100"><i class="fas fa-calendar-check me-1"></i>View Records</a>
                </div>
                <div class="col-md-3">
                    <a href="/LeaveRequests?employeeId=@Model.Id" class="btn btn-success w-100"><i class="fas fa-leaf me-1"></i>View Leaves</a>
                </div>
                <div class="col-md-3">
                    <a href="/PayrollSlip/Summary?employeeId=@Model.Id" class="btn btn-warning w-100"><i class="fas fa-money-bill-wave me-1"></i>View Payslips</a>
                </div>
                <div class="col-md-3">
                    <a href="/EmployeeDocuments?employeeId=@Model.Id" class="btn btn-primary w-100"><i class="fas fa-file-alt me-1"></i>View Docs</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#createUserAccountBtn').on('click', function() {
                if (!confirm('Create a user account for this employee?')) return;
                $.post('/EmployeeManagement/CreateUserAccount', { employeeId: '@Model.Id' })
                    .done(function(response) {
                        if (response.success) {
                            alert('User created! Temporary password: ' + response.tempPassword);
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    })
                    .fail(function() {
                        alert('An error occurred while creating the user account.');
                    });
            });
        });
    </script>
} 