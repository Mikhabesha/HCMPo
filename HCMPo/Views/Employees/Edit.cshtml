@model HCMPo.Models.Employee

@{
    ViewData["Title"] = "Edit Employee";
    var taxSettings = ViewBag.TaxSettings as List<HCMPo.Models.TaxSetting>;
    var pensionSetting = ViewBag.Pension as HCMPo.Models.TaxSetting ?? new HCMPo.Models.TaxSetting { Percentage = 7 };
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Edit Employee</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" id="employeeForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="BadgeNumber" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="FirstName" class="control-label"></label>
                                    <input asp-for="FirstName" class="form-control" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="LastName" class="control-label"></label>
                                    <input asp-for="LastName" class="form-control" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Email" class="control-label"></label>
                                    <input asp-for="Email" class="form-control" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="PhoneNumber" class="control-label"></label>
                                    <input asp-for="PhoneNumber" class="form-control" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="DepartmentId" class="control-label">Department</label>
                                    <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.DepartmentId"></select>
                                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="JobTitleId" class="control-label">Job Title</label>
                                    <select asp-for="JobTitleId" class="form-control" asp-items="ViewBag.JobTitleId"></select>
                                    <span asp-validation-for="JobTitleId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="SupervisorId" class="control-label">Supervisor</label>
                                    <select asp-for="SupervisorId" class="form-control" asp-items="ViewBag.SupervisorId">
                                        <option value="">-- Select Supervisor --</option>
                                    </select>
                                    <span asp-validation-for="SupervisorId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="BasicSalary" class="control-label"></label>
                                    <input asp-for="BasicSalary" class="form-control" type="number" step="0.01" id="basicSalary" />
                                    <span asp-validation-for="BasicSalary" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-md-12">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="incomeTax" name="taxes" value="IncomeTax" @(ViewBag.AppliedTaxes != null && ViewBag.AppliedTaxes.ContainsKey("Income Tax") ? "checked" : "")>
                                    <label class="form-check-label" for="incomeTax">
                                        Apply Income Tax
                                    </label>
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="pension" name="taxes" value="Pension" @(ViewBag.AppliedTaxes != null && ViewBag.AppliedTaxes.ContainsKey("Pension") ? "checked" : "")>
                                    <label class="form-check-label" for="pension">
                                        Apply Pension (7%)
                                    </label>
                                </div>
                                <h4>Tax Calculation</h4>
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Gross Salary</label>
                                                    <input type="text" class="form-control" id="grossSalary" readonly />
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Total Tax</label>
                                                    <input type="text" class="form-control" id="totalTax" readonly />
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Net Salary</label>
                                                    <input type="text" class="form-control" id="netSalary" readonly />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mt-3">
                                            <div class="col-md-12">
                                                <h5>Tax Breakdown</h5>
                                                <table class="table table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Tax Type</th>
                                                            <th>Rate</th>
                                                            <th>Amount</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="taxBreakdown">
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-12">
                                <label class="form-label">Other Deductions</label>
                                <div id="deductionTypesList" class="row">
                                    @foreach (var dt in ViewBag.DeductionTypes)
                                    {
                                        var checkedAttr = (ViewBag.AppliedTaxes != null && ViewBag.AppliedTaxes.ContainsKey(dt.DisplayName)) ? "checked" : "";
                                        var valueAttr = (ViewBag.AppliedTaxes != null && ViewBag.AppliedTaxes.ContainsKey(dt.DisplayName)) ? ViewBag.AppliedTaxes[dt.DisplayName].ToString() : "";
                                        var enabledAttr = (ViewBag.AppliedTaxes != null && ViewBag.AppliedTaxes.ContainsKey(dt.DisplayName)) ? "" : "disabled";
                                        <div class="col-12 col-md-6 col-lg-4 mb-2">
                                            <div class="input-group">
                                                <div class="input-group-text">
                                                    <input class="form-check-input deduction-checkbox" type="checkbox" id="deduction_@dt.Id" name="deduction_@dt.Id" data-id="@dt.Id" data-name="@dt.DisplayName" @checkedAttr />
                                                </div>
                                                <label class="input-group-text flex-grow-1" for="deduction_@dt.Id">@dt.DisplayName</label>
                                                <input type="number" class="form-control deduction-value" id="deductionValue_@dt.Id" name="deductionValue_@dt.Id" data-id="@dt.Id" min="0" step="0.01" placeholder="Amount" value="@valueAttr" @enabledAttr />
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            var taxSettings = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.TaxSettings ?? new List<HCMPo.Models.TaxSetting>()));
            var pensionSetting = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Pension ?? new HCMPo.Models.TaxSetting { Percentage = 7 }));

            function getApplicableIncomeTaxBracket(gross) {
                if (!taxSettings || taxSettings.length === 0) return null;
                return taxSettings.find(function(bracket) {
                    var min = bracket.MinSalary || bracket.minSalary || 0;
                    var max = bracket.MaxSalary || bracket.maxSalary || Infinity;
                    return gross >= min && gross <= max;
                });
            }

            function updateTaxesAndNetSalary() {
                var gross = parseFloat($('#basicSalary').val()) || 0;
                $('#grossSalary').val(gross.toFixed(2));

                var totalTax = 0;
                var taxBreakdown = [];

                // Income Tax
                var incomeTaxBracket = getApplicableIncomeTaxBracket(gross);
                var incomeTax = 0;
                if (incomeTaxBracket && $('#incomeTax').is(':checked')) {
                    var subtraction = incomeTaxBracket.Subtraction || incomeTaxBracket.subtraction || 0;
                    incomeTax = (gross * incomeTaxBracket.Percentage / 100) - subtraction;
                    if (incomeTax > 0) {
                        totalTax += incomeTax;
                        taxBreakdown.push({
                            type: 'Income Tax',
                            rate: incomeTaxBracket.Percentage + '%',
                            amount: incomeTax.toFixed(2),
                            subtraction: subtraction
                        });
                    }
                }

                // Pension
                var pensionTax = 0;
                if (pensionSetting && $('#pension').is(':checked')) {
                    var pensionPercent = pensionSetting.Percentage || pensionSetting.percentage || 0;
                    pensionTax = gross * pensionPercent / 100;
                    totalTax += pensionTax;
                    taxBreakdown.push({
                        type: 'Pension',
                        rate: pensionPercent + '%',
                        amount: pensionTax.toFixed(2)
                    });
                }

                // Multi Other Deductions
                $('.deduction-checkbox').each(function () {
                    var id = $(this).data('id');
                    var name = $(this).data('name');
                    var valueInput = $('#deductionValue_' + id);
                    if ($(this).is(':checked')) {
                        valueInput.prop('disabled', false);
                        var deductionAmount = parseFloat(valueInput.val()) || 0;
                        if (deductionAmount > 0) {
                            totalTax += deductionAmount;
                            taxBreakdown.push({
                                type: name,
                                rate: '',
                                amount: deductionAmount.toFixed(2)
                            });
                        }
                    } else {
                        valueInput.prop('disabled', true).val('');
                    }
                });

                var net = gross - totalTax;
                $('#netSalary').val(net.toFixed(2));
                $('#totalTax').val(totalTax.toFixed(2));

                // Update tax breakdown table
                var tbody = $('#taxBreakdown');
                tbody.empty();
                taxBreakdown.forEach(function (tax) {
                    var row = `<tr><td>${tax.type}</td><td>${tax.rate}</td><td>${tax.amount}</td></tr>`;
                    tbody.append(row);
                });
            }

            // Attach event handlers
            $('#basicSalary').on('input', updateTaxesAndNetSalary);
            $('#incomeTax').on('change', updateTaxesAndNetSalary);
            $('#pension').on('change', updateTaxesAndNetSalary);

            // Enable/disable deduction input immediately on checkbox toggle
            $(document).on('change', '.deduction-checkbox', function () {
                var id = $(this).data('id');
                var valueInput = $('#deductionValue_' + id);
                if ($(this).is(':checked')) {
                    valueInput.prop('disabled', false).focus();
                } else {
                    valueInput.prop('disabled', true).val('');
                }
                updateTaxesAndNetSalary();
            });

            $(document).on('input', '.deduction-value', updateTaxesAndNetSalary);

            // Initialize calculations
            updateTaxesAndNetSalary();
        });
    </script>
} 