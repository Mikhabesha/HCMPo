@model HCMPo.Models.Employee
@using HCMPo.Helpers

@{
    ViewData["Title"] = "Edit Employee";
    var taxSettings = ViewBag.TaxSettings as List<HCMPo.Models.TaxSetting>;
    var pensionSetting = ViewBag.Pension as HCMPo.Models.TaxSetting ?? new HCMPo.Models.TaxSetting { Percentage = 7 };
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-user-edit"></i>
                        Edit Employee: @Model.FullName
                    </h3>
                    <div class="card-tools">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" id="editEmployeeForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />
                        
                        <!-- Personal Information Section -->
                        <div class="row">
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">
                                    <i class="fas fa-user"></i> Personal Information
                                </h5>
                                <div class="form-group mb-3">
                                    <label asp-for="FirstName" class="form-label"></label>
                                    <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="LastName" class="form-label"></label>
                                    <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="AmharicFirstName" class="form-label">First Name (አማርኛ)</label>
                                    <input asp-for="AmharicFirstName" class="form-control" placeholder="Enter first name in Amharic" />
                                    <span asp-validation-for="AmharicFirstName" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="AmharicLastName" class="form-label">Last Name (አማርኛ)</label>
                                    <input asp-for="AmharicLastName" class="form-control" placeholder="Enter last name in Amharic" />
                                    <span asp-validation-for="AmharicLastName" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control" placeholder="Enter email address" type="email" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="PhoneNumber" class="form-label"></label>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="Gender" class="form-label"></label>
                                    <select asp-for="Gender" class="form-control">
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Date of Birth (የተወለደበት ቀን)</label>
                                        @await Html.PartialAsync("_EthiopianDatePicker", new { Id = "DateOfBirth", Name = "DateOfBirth", Label = "Date of Birth", IsRequired = true, ShowGregorian = true, InitialDate = Model.DateOfBirth != default(DateTime) ? Model.DateOfBirth : (DateTime?)null, Placeholder = "Select Date of Birth" })
                                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Employment Information Section -->
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">
                                    <i class="fas fa-briefcase"></i> Employment Information
                                </h5>
                                <div class="form-group mb-3">
                                    <label asp-for="BadgeNumber" class="form-label"></label>
                                    <div class="input-group">
                                        <input asp-for="BadgeNumber" class="form-control" placeholder="Enter badge number" id="badgeNumber" readonly />
                                        <button type="button" class="btn btn-outline-secondary" onclick="checkBadgeNumber()">
                                            <i class="fas fa-search"></i> Check
                                        </button>
                                    </div>
                                    <span asp-validation-for="BadgeNumber" class="text-danger"></span>
                                    <div id="badgeNumberStatus" class="mt-1">
                                        <small class="text-muted"><i class="fas fa-info-circle"></i> Badge number cannot be changed</small>
                                    </div>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="OrganizationUnitId" class="form-label">Department/Directorate</label>
                                    <select asp-for="OrganizationUnitId" class="form-control" asp-items="ViewBag.OrganizationUnits">
                                        <option value="">Select Organization Unit</option>
                                    </select>
                                    <span asp-validation-for="OrganizationUnitId" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="JobTitleId" class="form-label">Job Title</label>
                                    <select asp-for="JobTitleId" class="form-control" asp-items="ViewBag.JobTitles">
                                        <option value="">Select Job Title</option>
                                    </select>
                                    <span asp-validation-for="JobTitleId" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="SupervisorId" class="form-label">Supervisor</label>
                                    <select asp-for="SupervisorId" class="form-control" asp-items="ViewBag.Supervisors">
                                        <option value="">-- Select Supervisor --</option>
                                    </select>
                                    <span asp-validation-for="SupervisorId" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Employment Date (የስራ መጀመሪያ ቀን)</label>
                                        @await Html.PartialAsync("_EthiopianDatePicker", new { Id = "EmploymentDate", Name = "EmploymentDate", Label = "Employment Date", IsRequired = true, ShowGregorian = true, InitialDate = Model.EmploymentDate != default(DateTime) ? Model.EmploymentDate : (DateTime?)null, Placeholder = "Select Employment Date" })
                                        <span asp-validation-for="EmploymentDate" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <label class="form-label">Hire Date (የተቀጠረበት ቀን)</label>
                                        @await Html.PartialAsync("_EthiopianDatePicker", new { Id = "HireDate", Name = "HireDate", Label = "Hire Date", IsRequired = false, ShowGregorian = true, InitialDate = Model.HireDate != default(DateTime) ? Model.HireDate : (DateTime?)null, Placeholder = "Select Hire Date" })
                                        <span asp-validation-for="HireDate" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="BasicSalary" class="form-label">Gross Salary</label>
                                    <input id="grossSalary" name="BasicSalary" class="form-control" type="number" step="0.01" value="@Model.BasicSalary" required />
                                    <span asp-validation-for="BasicSalary" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label for="netSalary" class="form-label">Net Salary</label>
                                    <input id="netSalary" name="Salary" class="form-control" type="number" step="0.01" value="@Model.Salary" readonly />
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="Status" class="form-label"></label>
                                    <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<HCMPo.Models.EmploymentStatus>()">
                                        <option value="">-- Select Status --</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Tax Configuration Section -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h5 class="text-primary mb-3">
                                    <i class="fas fa-calculator"></i> Tax Configuration
                                </h5>
                                <div class="mb-3">
                                    <label class="form-label">Select Taxes</label><br />
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="incomeTax" name="taxes" value="IncomeTax" @(ViewBag.AppliedTaxes != null && ViewBag.AppliedTaxes.ContainsKey("Income Tax") ? "checked" : "")>
                                        <label class="form-check-label" for="incomeTax">Income Tax</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="pension" name="taxes" value="Pension" @(ViewBag.AppliedTaxes != null && ViewBag.AppliedTaxes.ContainsKey("Pension") ? "checked" : "")>
                                        <label class="form-check-label" for="pension">Pension</label>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Other Deductions</label>
                                        <div id="deductionTypesList" class="row">
                                            @foreach (var dt in ViewBag.DeductionTypes)
                                            {
                                                var checkedAttr = (ViewBag.AppliedTaxes != null && ViewBag.AppliedTaxes.ContainsKey(dt.DisplayName)) ? "checked" : "";
                                                var valueAttr = (ViewBag.AppliedTaxes != null && ViewBag.AppliedTaxes.ContainsKey(dt.DisplayName)) ? ViewBag.AppliedTaxes[dt.DisplayName].ToString() : "";
                                                var enabledAttr = (ViewBag.AppliedTaxes != null && ViewBag.AppliedTaxes.ContainsKey(dt.DisplayName)) ? "" : "disabled";
                                                <div class="col-12 col-md-6 col-lg-4 mb-2">
                                                    <div class="input-group">
                                                        <div class="input-group-text">
                                                            <input class="form-check-input deduction-checkbox" type="checkbox" id="deduction_@dt.Id" data-id="@dt.Id" data-name="@dt.DisplayName" @checkedAttr>
                                                        </div>
                                                        <label class="input-group-text flex-grow-1" for="deduction_@dt.Id">@dt.DisplayName</label>
                                                        <input type="number" class="form-control deduction-value" id="deductionValue_@dt.Id" data-id="@dt.Id" min="0" step="0.01" placeholder="Amount" value="@valueAttr" @enabledAttr />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tax Breakdown Section -->
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <h5>Tax Breakdown</h5>
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Tax Type</th>
                                            <th>Rate</th>
                                            <th>Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody id="taxBreakdown">
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Additional Information Section -->
                        <div class="row">
                            <div class="col-12">
                                <h5 class="text-primary mb-3 mt-3">
                                    <i class="fas fa-info-circle"></i> Additional Information
                                </h5>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Address" class="form-label"></label>
                                    <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter address"></textarea>
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="City" class="form-label"></label>
                                    <input asp-for="City" class="form-control" placeholder="Enter city" />
                                    <span asp-validation-for="City" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="Position" class="form-label"></label>
                                    <input asp-for="Position" class="form-control" placeholder="Enter position" />
                                    <span asp-validation-for="Position" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="BankName" class="form-label"></label>
                                    <input asp-for="BankName" class="form-control" placeholder="Enter bank name" />
                                    <span asp-validation-for="BankName" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="BankAccountNumber" class="form-label"></label>
                                    <input asp-for="BankAccountNumber" class="form-control" placeholder="Enter bank account number" />
                                    <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="TinNumber" class="form-label"></label>
                                    <input asp-for="TinNumber" class="form-control" placeholder="Enter TIN number" />
                                    <span asp-validation-for="TinNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12 text-end">
                                <button type="submit" class="btn btn-success" id="submitBtn">
                                    <i class="fas fa-save"></i> Update Employee
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Back to List
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        var incomeTaxBrackets = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.IncomeTaxBrackets ?? new List<HCMPo.Models.TaxSetting>()));
        var pension = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Pension));
        let badgeNumberValid = true; // For edit, badge number is already valid

        function getApplicableIncomeTaxBracket(gross) {
            for (var i = 0; i < incomeTaxBrackets.length; i++) {
                var b = incomeTaxBrackets[i];
                if (gross >= b.MinSalary && gross <= b.MaxSalary) return b;
            }
            return null;
        }

        function updateTaxesAndNetSalary() {
            var gross = parseFloat(document.getElementById('grossSalary').value) || 0;
            var totalTax = 0;
            var taxBreakdown = [];
            
            // Income Tax
            var incomeTaxBracket = getApplicableIncomeTaxBracket(gross);
            var incomeTax = 0;
            if (incomeTaxBracket && document.getElementById('incomeTax').checked) {
                var subtraction = incomeTaxBracket.Subtraction || incomeTaxBracket.subtraction || 0;
                incomeTax = (gross * incomeTaxBracket.Percentage / 100) - subtraction;
                if (incomeTax > 0) {
                    totalTax += incomeTax;
                    taxBreakdown.push({
                        type: 'Income Tax',
                        rate: incomeTaxBracket.Percentage + '%',
                        amount: incomeTax.toFixed(2),
                        subtraction: subtraction
                    });
                }
            }
            
            // Pension
            var pensionTax = 0;
            if (pension && document.getElementById('pension').checked) {
                var pensionPercent = pension.Percentage || pension.percentage || 7;
                pensionTax = gross * pensionPercent / 100;
                totalTax += pensionTax;
                taxBreakdown.push({
                    type: 'Pension',
                    rate: pensionPercent + '%',
                    amount: pensionTax.toFixed(2)
                });
            }
            
            // Other Deductions
            document.querySelectorAll('.deduction-checkbox').forEach(function(checkbox) {
                if (checkbox.checked) {
                    var id = checkbox.getAttribute('data-id');
                    var name = checkbox.getAttribute('data-name');
                    var valueInput = document.getElementById('deductionValue_' + id);
                    valueInput.disabled = false;
                    var deductionAmount = parseFloat(valueInput.value) || 0;
                    if (deductionAmount > 0) {
                        totalTax += deductionAmount;
                        taxBreakdown.push({
                            type: name,
                            rate: '',
                            amount: deductionAmount.toFixed(2)
                        });
                    }
                } else {
                    var id = checkbox.getAttribute('data-id');
                    var valueInput = document.getElementById('deductionValue_' + id);
                    valueInput.disabled = true;
                    valueInput.value = '';
                }
            });
            
            var net = gross - totalTax;
            document.getElementById('netSalary').value = net.toFixed(2);
            
            // Update tax breakdown table
            var tbody = document.getElementById('taxBreakdown');
            tbody.innerHTML = '';
            taxBreakdown.forEach(function(tax) {
                var row = tbody.insertRow();
                row.insertCell(0).textContent = tax.type;
                row.insertCell(1).textContent = tax.rate;
                row.insertCell(2).textContent = tax.amount;
            });
        }

        // Enable/disable deduction inputs based on checkbox state
        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('deduction-checkbox')) {
                var id = e.target.getAttribute('data-id');
                var valueInput = document.getElementById('deductionValue_' + id);
                if (e.target.checked) {
                    valueInput.disabled = false;
                    valueInput.focus();
                } else {
                    valueInput.disabled = true;
                    valueInput.value = '';
                }
                updateTaxesAndNetSalary();
            }
        });

        // Update calculations when inputs change
        document.getElementById('grossSalary').addEventListener('input', updateTaxesAndNetSalary);
        document.getElementById('incomeTax').addEventListener('change', updateTaxesAndNetSalary);
        document.getElementById('pension').addEventListener('change', updateTaxesAndNetSalary);
        document.addEventListener('input', function(e) {
            if (e.target.classList.contains('deduction-value')) {
                updateTaxesAndNetSalary();
            }
        });

        // Form submission validation
        document.getElementById('editEmployeeForm').addEventListener('submit', function(e) {
            var allDatesValid = true;
            var missingDates = [];

            ['DateOfBirth', 'EmploymentDate'].forEach(function(id) {
                var input = document.getElementById(id + 'Gregorian');
                if (!input || !input.value) {
                    allDatesValid = false;
                    var labelFor = id === 'DateOfBirth' ? 'Date of Birth (የተወለደበት ቀን)' : 'Employment Date (የስራ መጀመሪያ ቀን)';
                    missingDates.push(labelFor.split('(')[0].trim());
                }
            });

            if (!allDatesValid) {
                e.preventDefault();
                Swal.fire('Validation Error', 'Please select the following required dates: ' + missingDates.join(', '), 'error');
            }
        });

        // Initialize calculations on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateTaxesAndNetSalary();
        });
    </script>
} 