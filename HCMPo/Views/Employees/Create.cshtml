@model HCMPo.Models.Employee
@using HCMPo.Helpers

@{
    ViewData["Title"] = "Create Employee";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-user-plus"></i>
                        Create New Employee
                    </h3>
                    <div class="card-tools">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" id="createEmployeeForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <!-- Personal Information Section -->
                        <div class="row">
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">
                                    <i class="fas fa-user"></i> Personal Information
                                </h5>
                                <div class="form-group mb-3">
                                    <label asp-for="FirstName" class="form-label"></label>
                                    <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="LastName" class="form-label"></label>
                                    <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control" placeholder="Enter email address" type="email" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="PhoneNumber" class="form-label"></label>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="Gender" class="form-label"></label>
                                    <select asp-for="Gender" class="form-control">
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label">Date of Birth (የተወለደበት ቀን)</label>
                                    @await Html.PartialAsync("_EthiopianDatePicker", new { Id = "DateOfBirth", Name = "DateOfBirth", Label = "Date of Birth", IsRequired = true, ShowGregorian = true, Placeholder = "Select Date of Birth", InitialDate = (DateTime?)null })
                                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <!-- Employment Information Section -->
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">
                                    <i class="fas fa-briefcase"></i> Employment Information
                                </h5>
                                <div class="form-group mb-3">
                                    <label asp-for="BadgeNumber" class="form-label"></label>
                                    <div class="input-group">
                                        <input asp-for="BadgeNumber" class="form-control" placeholder="Enter badge number" id="badgeNumber" />
                                        <button type="button" class="btn btn-outline-secondary" onclick="checkBadgeNumber()">
                                            <i class="fas fa-search"></i> Check
                                        </button>
                                    </div>
                                    <span asp-validation-for="BadgeNumber" class="text-danger"></span>
                                    <div id="badgeNumberStatus" class="mt-1"></div>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="OrganizationUnitId" class="form-label">Department/Directorate</label>
                                    <select asp-for="OrganizationUnitId" class="form-control" asp-items="ViewBag.OrganizationUnitId">
                                        <option value="">Select Organization Unit</option>
                                    </select>
                                    <span asp-validation-for="OrganizationUnitId" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="JobTitleId" class="form-label">Job Title</label>
                                    <select asp-for="JobTitleId" class="form-control" asp-items="ViewBag.JobTitleId">
                                        <option value="">Select Job Title</option>
                                    </select>
                                    <span asp-validation-for="JobTitleId" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label">Hire Date (የተቀጠረበት ቀን)</label>
                                    @await Html.PartialAsync("_EthiopianDatePicker", new { Id = "HireDate", Name = "HireDate", Label = "Hire Date", IsRequired = false, ShowGregorian = true, Placeholder = "Select Hire Date", InitialDate = (DateTime?)null })
                                    <span asp-validation-for="HireDate" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label">Employment Date (የስራ መጀመሪያ ቀን)</label>
                                    @await Html.PartialAsync("_EthiopianDatePicker", new { Id = "EmploymentDate", Name = "EmploymentDate", Label = "Employment Date", IsRequired = true, ShowGregorian = true, Placeholder = "Select Employment Date", InitialDate = (DateTime?)null })
                                    <span asp-validation-for="EmploymentDate" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="BasicSalary" class="form-label">Gross Salary</label>
                                    <input id="grossSalary" name="BasicSalary" class="form-control" type="number" step="0.01" required />
                                    <span asp-validation-for="BasicSalary" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label for="netSalary" class="form-label">Net Salary</label>
                                    <input id="netSalary" name="Salary" class="form-control" type="number" step="0.01" readonly />
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="Status" class="form-label"></label>
                                    <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<HCMPo.Models.EmploymentStatus>()">
                                        <option value="">-- Select Status --</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="TerminationDate" class="form-label">Termination Date (የስራ ማብቂያ ቀን)</label>
                                    @await Html.PartialAsync("_EthiopianDatePicker", new { Id = "TerminationDate", Name = "TerminationDate", Label = "Termination Date", IsRequired = false, ShowGregorian = true, Placeholder = "Select Termination Date", InitialDate = (DateTime?)null })
                                    <span asp-validation-for="TerminationDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Tax Configuration Section -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h5 class="text-primary mb-3">
                                    <i class="fas fa-calculator"></i> Tax Configuration
                                </h5>
                                <div class="mb-3">
                                    <label class="form-label">Select Taxes</label><br />
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="incomeTax" name="taxes" value="IncomeTax" checked>
                                        <label class="form-check-label" for="incomeTax">Income Tax</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="pension" name="taxes" value="Pension" checked>
                                        <label class="form-check-label" for="pension">Pension</label>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Other Deductions</label>
                                        <div id="deductionTypesList" class="row">
                                            @foreach (var dt in ViewBag.DeductionTypes)
                                            {
                                                <div class="col-12 col-md-6 col-lg-4 mb-2">
                                                    <div class="input-group">
                                                        <div class="input-group-text">
                                                            <input class="form-check-input deduction-checkbox" type="checkbox" id="deduction_@dt.Id" data-id="@dt.Id" data-name="@dt.DisplayName">
                                                        </div>
                                                        <label class="input-group-text flex-grow-1" for="deduction_@dt.Id">@dt.DisplayName</label>
                                                        <input type="number" class="form-control deduction-value" id="deductionValue_@dt.Id" data-id="@dt.Id" min="0" step="0.01" placeholder="Amount" disabled />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tax Breakdown Section -->
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <h5>Tax Breakdown</h5>
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Tax Type</th>
                                            <th>Rate</th>
                                            <th>Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody id="taxBreakdown">
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Additional Information Section -->
                        <div class="row">
                            <div class="col-12">
                                <h5 class="text-primary mb-3 mt-3">
                                    <i class="fas fa-info-circle"></i> Additional Information
                                </h5>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Address" class="form-label"></label>
                                    <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter address"></textarea>
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="City" class="form-label"></label>
                                    <input asp-for="City" class="form-control" placeholder="Enter city" />
                                    <span asp-validation-for="City" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="Position" class="form-label"></label>
                                    <input asp-for="Position" class="form-control" placeholder="Enter position" />
                                    <span asp-validation-for="Position" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="BankName" class="form-label"></label>
                                    <input asp-for="BankName" class="form-control" placeholder="Enter bank name" />
                                    <span asp-validation-for="BankName" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="BankAccountNumber" class="form-label"></label>
                                    <input asp-for="BankAccountNumber" class="form-control" placeholder="Enter bank account number" />
                                    <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="TinNumber" class="form-label"></label>
                                    <input asp-for="TinNumber" class="form-control" placeholder="Enter TIN number" />
                                    <span asp-validation-for="TinNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12 text-end">
                                <button type="submit" class="btn btn-success" id="submitBtn">
                                    <i class="fas fa-save"></i> Create Employee
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        var incomeTaxBrackets = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.IncomeTaxBrackets ?? new List<HCMPo.Models.TaxSetting>()));
        var pension = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Pension));
        let badgeNumberValid = false;

        function getApplicableIncomeTaxBracket(gross) {
            for (var i = 0; i < incomeTaxBrackets.length; i++) {
                var b = incomeTaxBrackets[i];
                if (gross >= b.MinSalary && gross <= b.MaxSalary) return b;
            }
            return null;
        }

        function updateTaxesAndNetSalary() {
            var gross = parseFloat(document.getElementById('grossSalary').value) || 0;
            var totalTax = 0;
            var taxBreakdown = [];
            // Income Tax
            var incomeTaxBracket = getApplicableIncomeTaxBracket(gross);
            var incomeTax = 0;
            if (incomeTaxBracket && document.getElementById('incomeTax').checked) {
                var subtraction = incomeTaxBracket.Subtraction || incomeTaxBracket.subtraction || 0;
                incomeTax = (gross * incomeTaxBracket.Percentage / 100) - subtraction;
                if (incomeTax > 0) {
                    totalTax += incomeTax;
                    taxBreakdown.push({
                        type: 'Income Tax',
                        rate: incomeTaxBracket.Percentage + '%',
                        amount: incomeTax.toFixed(2),
                        subtraction: subtraction
                    });
                }
            }
            // Pension
            var pensionTax = 0;
            if (pension && document.getElementById('pension').checked) {
                var pensionPercent = pension.Percentage || pension.percentage || 0;
                pensionTax = gross * pensionPercent / 100;
                totalTax += pensionTax;
                taxBreakdown.push({
                    type: 'Pension',
                    rate: pensionPercent + '%',
                    amount: pensionTax.toFixed(2)
                });
            }
            // Multi Other Deductions
            var deductionCheckboxes = document.querySelectorAll('.deduction-checkbox');
            deductionCheckboxes.forEach(function(checkbox) {
                var id = checkbox.getAttribute('data-id');
                var name = checkbox.getAttribute('data-name');
                var valueInput = document.getElementById('deductionValue_' + id);
                if (checkbox.checked) {
                    valueInput.disabled = false;
                    var deductionAmount = parseFloat(valueInput.value) || 0;
                    if (deductionAmount > 0) {
                        totalTax += deductionAmount;
                        taxBreakdown.push({
                            type: name,
                            rate: '',
                            amount: deductionAmount.toFixed(2)
                        });
                    }
                } else {
                    valueInput.disabled = true;
                    valueInput.value = '';
                }
            });
            var net = gross - totalTax;
            document.getElementById('netSalary').value = net.toFixed(2);
            // Update tax breakdown table
            var tbody = document.getElementById('taxBreakdown');
            tbody.innerHTML = '';
            taxBreakdown.forEach(function(tax) {
                var row = document.createElement('tr');
                row.innerHTML = `<td>${tax.type}</td><td>${tax.rate}</td><td>${tax.amount}</td>`;
                tbody.appendChild(row);
            });
        }

        function checkBadgeNumber() {
            const badgeNumber = $('#badgeNumber').val().trim();
            const statusDiv = $('#badgeNumberStatus');
            
            if (!badgeNumber) {
                statusDiv.html('<small class="text-warning"><i class="fas fa-exclamation-triangle"></i> Please enter a badge number</small>');
                badgeNumberValid = false;
                return;
            }

            // Show loading
            statusDiv.html('<small class="text-info"><i class="fas fa-spinner fa-spin"></i> Checking badge number...</small>');

            $.get('@Url.Action("CheckBadgeNumber", "Employees")', { badgeNumber: badgeNumber })
                .done(function(response) {
                    if (response.isAvailable) {
                        statusDiv.html('<small class="text-success"><i class="fas fa-check-circle"></i> Badge number is available</small>');
                        badgeNumberValid = true;
                    } else {
                        statusDiv.html('<small class="text-danger"><i class="fas fa-times-circle"></i> Badge number already exists</small>');
                        badgeNumberValid = false;
                    }
                })
                .fail(function() {
                    statusDiv.html('<small class="text-danger"><i class="fas fa-exclamation-triangle"></i> Error checking badge number</small>');
                    badgeNumberValid = false;
                });
        }

        // Auto-check badge number when user stops typing
        let badgeNumberTimeout;
        $('#badgeNumber').on('input', function() {
            clearTimeout(badgeNumberTimeout);
            badgeNumberTimeout = setTimeout(checkBadgeNumber, 1000);
        });

        // Form submission validation
        document.getElementById('createEmployeeForm').addEventListener('submit', function(e) {
            var allDatesValid = true;
            var missingDates = [];

            ['DateOfBirth', 'EmploymentDate'].forEach(function(id) {
                var input = document.getElementById(id + 'Gregorian');
                if (!input || !input.value) {
                    allDatesValid = false;
                    missingDates.push(document.querySelector(`label[for="${id}"]`).innerText.replace('(የተወለደበት ቀን)','').replace('(የስራ መጀመሪያ ቀን)','').trim());
                }
            });

            if (!allDatesValid) {
                e.preventDefault();
                Swal.fire('Validation Error', 'Please select the following required dates: ' + missingDates.join(', '), 'error');
            } else if (!badgeNumberValid) {
                e.preventDefault();
                Swal.fire('Validation Error', 'Badge number is not available. Please enter a unique one.', 'error');
            }
        });

        function showAlert(message, type) {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 1050;">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            $('body').append(alertHtml);
            
            setTimeout(function() {
                $('.alert').alert('close');
            }, 5000);
        }

        document.getElementById('grossSalary').addEventListener('input', updateTaxesAndNetSalary);
        document.getElementById('incomeTax').addEventListener('change', updateTaxesAndNetSalary);
        document.getElementById('pension').addEventListener('change', updateTaxesAndNetSalary);
        document.querySelectorAll('.deduction-checkbox').forEach(function(cb) {
            cb.addEventListener('change', updateTaxesAndNetSalary);
        });
        document.querySelectorAll('.deduction-value').forEach(function(input) {
            input.addEventListener('input', updateTaxesAndNetSalary);
        });
        updateTaxesAndNetSalary();
        
        // Sync Ethiopian date picker values with hidden inputs
        $('form').on('submit', function(e) {
            syncEthiopianDates();
        });

        function syncEthiopianDates() {
            // Date of Birth
            const dobGregorian = $('#DateOfBirthGregorian').val();
            if (dobGregorian) {
                $('#DateOfBirth').val(dobGregorian);
            }

            // Employment Date
            const employmentGregorian = $('#EmploymentDateGregorian').val();
            if (employmentGregorian) {
                $('#EmploymentDate').val(employmentGregorian);
            }
        }
    </script>
} 