@model HCMPo.Models.EmployeeDocument
@{
    ViewData["Title"] = "Document Details";
}
<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h4><i class="fas fa-file-alt me-2"></i>Document Details</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Document Type</dt>
                <dd class="col-sm-9">@Model.DocumentType</dd>
                <dt class="col-sm-3">File Name</dt>
                <dd class="col-sm-9">@Model.FileName</dd>
                <dt class="col-sm-3">Upload Date</dt>
                <dd class="col-sm-9">@Model.UploadDate.ToString("yyyy-MM-dd HH:mm")</dd>
                <dt class="col-sm-3">Uploaded By</dt>
                <dd class="col-sm-9">@Model.UploadedBy</dd>
                <dt class="col-sm-3">Expiry Date</dt>
                <dd class="col-sm-9">@(Model.ExpiryDate?.ToString("yyyy-MM-dd") ?? "N/A")</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive) {
                        <span class="badge bg-success">Active</span>
                    } else {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </dd>
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
                <dt class="col-sm-3">Employee</dt>
                <dd class="col-sm-9">@Model.Employee?.FullName</dd>
            </dl>
            <div class="mt-3">
                <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-info">
                    <i class="fas fa-download"></i> Download File
                </a>
                <a asp-action="Index" asp-route-employeeId="@Model.EmployeeId" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Documents
                </a>
            </div>
        </div>
    </div>
</div> 