@model IEnumerable<HCMPo.Models.ViewModels.PayrollReportViewModel>
@using HCMPo.Models
@using HCMPo.Models.ViewModels
@{
    ViewData["Title"] = "Payroll Report";
    var employees = ViewBag.Employees as IEnumerable<dynamic>;
    var organizationUnits = ViewBag.OrganizationUnits as IEnumerable<dynamic>;
    var deductionTypes = ViewBag.DeductionTypes as List<DeductionType>;
    int rowNum = 1;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Payroll Report</h2>
    <div>
        <a href="@Url.Action("Index", "PayrollSlip")" class="btn btn-primary">
            <i class="fas fa-file-invoice-dollar"></i> Generate Payroll Slips
        </a>
    </div>
</div>
<form method="get" class="row mb-3">
    <div class="col-md-2">
        <label>Pay Period (Ethiopian)</label>
        <select name="payPeriod" class="form-control">
            <option value="">All</option>
            @if (ViewBag.PayPeriods != null)
            {
                foreach (var period in ViewBag.PayPeriods)
                {
                    var isSelected = Context.Request.Query["payPeriod"] == (string)period.Value ? "selected=\"selected\"" : "";
                    @:<option value="@period.Value" @Html.Raw(isSelected)>@period.Text</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label>Employee</label>
        <select name="employeeId" class="form-control">
            <option value="">All</option>
            @if (employees != null)
            {
                foreach (var e in employees)
                {
                    if (Context.Request.Query["employeeId"] == (string)e.Id)
                    {
                        <option value="@e.Id" selected="selected">@e.FullName</option>
                    }
                    else
                    {
                        <option value="@e.Id">@e.FullName</option>
                    }
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label>Organization Unit</label>
        <select name="organizationUnitId" class="form-control">
            <option value="">All</option>
            @if (ViewBag.OrganizationUnits != null)
            {
                foreach (var ou in ViewBag.OrganizationUnits)
                {
                    if (Context.Request.Query["organizationUnitId"] == (string)ou.Id)
                    {
                        <option value="@ou.Id" selected="selected">@ou.Name</option>
                    }
                    else
                    {
                        <option value="@ou.Id">@ou.Name</option>
                    }
                }
            }
        </select>
    </div>
    <div class="col-md-2 align-self-end">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>

<!-- Search and Table Descriptions -->
<div class="row mb-2">
    <div class="col-md-6">
        <input id="employeeSearch" type="text" class="form-control" placeholder="Search by employee name..." />
    </div>
</div>

<h4 class="table-section-header"><i class="fas fa-coins"></i> Allowances & Employer/Employee Taxes</h4>
<div class="scrollable-table centered-table mb-4">
    <table class="table table-bordered modern-table payroll-table-employee">
        <thead>
            <tr>
                <th class="number-col">#</th>
                <th>Employee</th>
                <th>Allowance</th>
                <th>Pension 11% (Employer)</th>
                <th>Income Tax</th>
                <th>Pension Tax (Employee 7%)</th>
            </tr>
        </thead>
        <tbody>
            @{ rowNum = 1; }
            @foreach (var p in Model)
            {
                <tr class="employee-row" data-employee-name="@p.EmployeeName">
                    <td class="number-col">@p.BadgeNumber</td>
                    <td>@p.EmployeeName</td>
                    <td>@p.TotalAllowance.ToString("N2")</td>
                    <td>@p.PensionEmployer.ToString("N2")</td>
                    <td>@p.IncomeTax.ToString("N2")</td>
                    <td>@p.PensionEmployee.ToString("N2")</td>
                </tr>
                rowNum++;
            }
        </tbody>
    </table>
</div>

<h4 class="table-section-header"><i class="fas fa-calculator"></i> Totals & Net Pay</h4>
<div class="scrollable-table centered-table mb-4">
    <table class="table table-bordered modern-table payroll-table-employee">
        <thead>
            <tr>
                <th class="number-col">#</th>
                <th>Employee</th>
                <th>Total Salary</th>
                <th>Total Deduction</th>
                <th>Net Pay Salary</th>
            </tr>
        </thead>
        <tbody>
            @{ rowNum = 1; }
            @foreach (var p in Model)
            {
                <tr class="employee-row" data-employee-name="@p.EmployeeName">
                    <td class="number-col">@p.BadgeNumber</td>
                    <td>@p.EmployeeName</td>
                    <td>@p.GrossSalary.ToString("N2")</td>
                    <td>@p.TotalDeductions.ToString("N2")</td>
                    <td>@p.NetPay.ToString("N2")</td>
                </tr>
                rowNum++;
            }
        </tbody>
    </table>
</div>

<h4 class="table-section-header"><i class="fas fa-minus-circle"></i> Deductions</h4>
<div class="scrollable-table centered-table mb-4">
    <table class="table table-bordered modern-table payroll-table-employee">
        <thead>
            <tr>
                <th class="number-col">#</th>
                <th>Employee</th>
                @if (deductionTypes != null && deductionTypes.Count > 0)
                {
                    foreach (var dt in deductionTypes)
                    {
                        <th>@dt.Name</th>
                    }
                }
            </tr>
        </thead>
        <tbody>
            @{ rowNum = 1; }
            @foreach (var p in Model)
            {
                <tr class="employee-row" data-employee-name="@p.EmployeeName">
                    <td class="number-col">@p.BadgeNumber</td>
                    <td>@p.EmployeeName</td>
                    @if (deductionTypes != null && deductionTypes.Count > 0)
                    {
                        foreach (var dt in deductionTypes)
                        {
                            var deduction = p.Deductions.FirstOrDefault(d => d.DeductionName == dt.Name);
                            <td>@(deduction != null ? deduction.Amount.ToString("N2") : "0.00")</td>
                        }
                    }
                </tr>
                rowNum++;
            }
        </tbody>
    </table>
</div>

<div class="mb-3">
    <div class="btn-group me-3">
        <a asp-action="ExportExcel" asp-route-start="@Context.Request.Query["start"]" asp-route-end="@Context.Request.Query["end"]" asp-route-employeeId="@Context.Request.Query["employeeId"]" asp-route-organizationUnitId="@Context.Request.Query["organizationUnitId"]" class="btn btn-success">
            <i class="fas fa-file-excel"></i> Export to Excel
        </a>
        <a asp-action="ExportCsv" asp-route-start="@Context.Request.Query["start"]" asp-route-end="@Context.Request.Query["end"]" asp-route-employeeId="@Context.Request.Query["employeeId"]" asp-route-organizationUnitId="@Context.Request.Query["organizationUnitId"]" class="btn btn-info">
            <i class="fas fa-file-csv"></i> Export to CSV
        </a>
        <a asp-action="ExportPdf" asp-route-start="@Context.Request.Query["start"]" asp-route-end="@Context.Request.Query["end"]" asp-route-employeeId="@Context.Request.Query["employeeId"]" asp-route-organizationUnitId="@Context.Request.Query["organizationUnitId"]" class="btn btn-danger">
            <i class="fas fa-file-pdf"></i> Export to PDF
        </a>
    </div>
    <div class="btn-group">
        <a href="@Url.Action("Index", "PayrollSlip")" class="btn btn-primary">
            <i class="fas fa-file-invoice-dollar"></i> Generate Individual Slips
        </a>
        <a href="@Url.Action("Summary", "PayrollSlip")" class="btn btn-outline-primary">
            <i class="fas fa-chart-bar"></i> Summary Reports
        </a>
    </div>
</div>

<link rel="stylesheet" href="~/css/payrollreport.css" />

<script>
// Simple search filter for all payroll tables by employee name
const searchInput = document.getElementById('employeeSearch');
if (searchInput) {
    searchInput.addEventListener('input', function() {
        const search = this.value.toLowerCase();
        document.querySelectorAll('.payroll-table-employee tbody .employee-row').forEach(row => {
            const name = row.dataset.employeeName.toLowerCase();
            row.style.display = name.includes(search) ? '' : 'none';
        });
    });
}
</script> 