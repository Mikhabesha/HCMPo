@model HCMPo.Models.LeaveRequest

@{
    ViewData["Title"] = "Create Leave Request";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-calendar-plus me-2"></i>Create Leave Request
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-controller="LeaveRequests" asp-action="Create" id="leaveRequestForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <input type="hidden" asp-for="EmployeeId" />
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="LeaveTypeId" class="form-label">Leave Type *</label>
                                <select asp-for="LeaveTypeId" class="form-select" asp-items="ViewBag.LeaveTypeId" id="leaveTypeSelect">
                                    <option value="">-- Select Leave Type --</option>
                                </select>
                                <span asp-validation-for="LeaveTypeId" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Half Day Request</label>
                                <div class="form-check">
                                    <input asp-for="IsHalfDay" class="form-check-input" type="checkbox" id="isHalfDay">
                                    <label class="form-check-label" for="isHalfDay">
                                        This is a half-day leave request
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">የጅምር ቀን (Start Date) *</label>
                                @await Html.PartialAsync("_EthiopianDatePicker", new { Id = "StartDate", Name = "StartDate", Label = "Start Date", IsRequired = true, ShowGregorian = true, InitialDate = (DateTime?)null, Placeholder = "Select Start Date" })
                                <input asp-for="StartDate" type="hidden" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6 mb-3" id="endDateSection">
                                <label class="form-label">የመጨረሻ ቀን (End Date) *</label>
                                @await Html.PartialAsync("_EthiopianDatePicker", new { Id = "EndDate", Name = "EndDate", Label = "End Date", IsRequired = true, ShowGregorian = true, InitialDate = (DateTime?)null, Placeholder = "Select End Date" })
                                <input asp-for="EndDate" type="hidden" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Duration Summary</label>
                            <div class="p-3 bg-light rounded">
                                <div class="row">
                                    <div class="col-md-4">
                                        <strong>Total Days:</strong>
                                        <span id="totalDays" class="badge bg-primary ms-2">0</span>
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Working Days:</strong>
                                        <span id="workingDays" class="badge bg-info ms-2">0</span>
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Weekends/Holidays:</strong>
                                        <span id="holidayDays" class="badge bg-secondary ms-2">0</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label">Reason *</label>
                            <textarea asp-for="Reason" class="form-control" rows="4" placeholder="Please provide a detailed reason for your leave request..."></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Attachment (Optional)</label>
                            <input type="file" class="form-control" id="attachment" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                            <div class="form-text">Supported formats: PDF, JPG, PNG, DOC, DOCX (Max 5MB)</div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="LeaveRequests" asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Back to List
                            </a>
                            <div>
                                <button type="button" class="btn btn-outline-primary me-2" id="saveDraftBtn">
                                    <i class="fas fa-save me-1"></i>Save as Draft
                                </button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-paper-plane me-1"></i>Submit Request
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <!-- Leave Balance Card -->
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-chart-pie me-2"></i>Leave Balance
                    </h5>
                </div>
                <div class="card-body">
                    <div id="leaveBalanceInfo">
                        <div class="text-center text-muted">
                            <i class="fas fa-info-circle"></i>
                            Select a leave type to view balance
                        </div>
                    </div>
                </div>
            </div>

            <!-- Policy Information Card -->
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>Leave Policy
                    </h5>
                </div>
                <div class="card-body">
                    <div id="policyInfo">
                        <ul class="list-unstyled mb-0">
                            <li><i class="fas fa-check text-success me-2"></i>Submit requests at least 3 days in advance</li>
                            <li><i class="fas fa-check text-success me-2"></i>Maximum 30 consecutive days</li>
                            <li><i class="fas fa-check text-success me-2"></i>Approval required from Team Lead → Director → HR</li>
                            <li><i class="fas fa-check text-success me-2"></i>Medical certificate required for sick leave > 3 days</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-rocket me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setDateRange(1)">
                            1 Day Leave
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setDateRange(3)">
                            3 Days Leave
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setDateRange(7)">
                            1 Week Leave
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setHalfDayToday()">
                            Half Day Today
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // =================================================================================
            // Configuration
            // =================================================================================
            const calculateUrl = '@Url.Action("CalculateWorkingDays", "LeaveRequests")';
            const convertDateUrl = '@Url.Action("ConvertEthiopianToGregorian", "EthiopianCalendar")';
            const leaveBalanceUrl = '@Url.Action("GetLeaveBalance", "LeaveRequests")';

            // =================================================================================
            // Event Handlers
            // =================================================================================
            
            // Central handler for any dropdown change in any date picker
            $(document).on('change', '.ethiopian-date-picker .form-select', function () {
                const pickerContainer = $(this).closest('.ethiopian-date-picker');
                
                // If year or month changed, we need to repopulate days
                if ($(this).hasClass('eth-year') || $(this).hasClass('eth-month')) {
                    populateDays(pickerContainer);
                }
                
                // After any change, try to update the hidden Gregorian date
                updateGregorianDateFromPicker(pickerContainer);
            });

            $('#isHalfDay').on('change', handleHalfDayToggle);
            $('#leaveTypeSelect').on('change', loadLeaveBalance);

            // =================================================================================
            // Initialization
            // =================================================================================
            
            // Initialize both date pickers on load
            $('.ethiopian-date-picker').each(function() {
                populateDays($(this));
                updateGregorianDateFromPicker($(this));
            });

            loadLeaveBalance();

            // =================================================================================
            // Core Logic
            // =================================================================================

            /**
             * Populates the day dropdown based on the selected Ethiopian year and month.
             */
            function populateDays(pickerContainer) {
                const year = parseInt(pickerContainer.find('.eth-year').val());
                const month = parseInt(pickerContainer.find('.eth-month').val());
                const daySelect = pickerContainer.find('.eth-day');
                const selectedDay = daySelect.val();

                daySelect.html('<option value="">Day</option>'); // Clear existing days

                if (!year || !month) return;

                const isLeap = (year % 4 === 3);
                const daysInMonth = (month === 13) ? (isLeap ? 6 : 5) : 30;

                for (let i = 1; i <= daysInMonth; i++) {
                    daySelect.append($('<option></option>').attr('value', i).text(i));
                }

                // Restore previous selection if possible
                if (selectedDay && selectedDay <= daysInMonth) {
                    daySelect.val(selectedDay);
                }
            }

            /**
             * Reads a picker's state, converts to Gregorian via API, and updates the hidden input.
             */
            function updateGregorianDateFromPicker(pickerContainer) {
                const year = pickerContainer.find('.eth-year').val();
                const month = pickerContainer.find('.eth-month').val();
                const day = pickerContainer.find('.eth-day').val();
                
                // The hidden input is a sibling to the picker's container div
                const targetHiddenInput = pickerContainer.parent().find('input[type="hidden"]');
                
                if (!year || !month || !day) {
                    targetHiddenInput.val('').trigger('change'); // Clear and notify
                    recalculateDuration(); // Recalculate (to show 0)
                    return;
                }

                $.get(convertDateUrl, { year, month, day })
                    .done(function(response) {
                        if (response.success) {
                            // Update hidden input - THIS IS THE SOURCE OF TRUTH
                            targetHiddenInput.val(response.gregorianDate);
                            
                            // Manually trigger validation on the element
                            $('#leaveRequestForm').validate().element('#' + targetHiddenInput.attr('id'));

                            // Update UI and recalculate duration
                            pickerContainer.find('.gregorian-equivalent').text(`(${response.formattedGregorianDate})`);
                            recalculateDuration();
                        } else {
                            console.error("Date conversion failed:", response.message);
                            targetHiddenInput.val('').trigger('change');
                        }
                    })
                    .fail(function() {
                        console.error("API call to convert date failed.");
                        targetHiddenInput.val('').trigger('change');
                    });
            }

            /**
             * Calculates the leave duration by calling the server.
             * Relies on the hidden #StartDate and #EndDate inputs.
             */
            function recalculateDuration() {
                const startDate = $('#StartDate').val();
                // For half-day, end date is same as start date. Otherwise, use the EndDate input.
                const endDate = $('#isHalfDay').is(':checked') ? startDate : $('#EndDate').val();

                // Don't proceed if either date is missing (unless it's a half-day request)
                if (!startDate || (!endDate && !$('#isHalfDay').is(':checked'))) {
                    updateDurationSummaryUI(0, 0, 0);
                    return;
                }

                $.get(calculateUrl, { startDate, endDate })
                    .done(function(response) {
                        if (response.success) {
                            const workingDays = $('#isHalfDay').is(':checked') ? 0.5 : response.workingDays;
                            const totalDays = $('#isHalfDay').is(':checked') ? 0.5 : response.totalDays;
                            updateDurationSummaryUI(totalDays, workingDays, response.weekendDays);
                        } else {
                            updateDurationSummaryUI('Err', 'Err', 'Err');
                        }
                    })
                    .fail(function() {
                        updateDurationSummaryUI('Err', 'Err', 'Err');
                    });
            }
            
            function handleHalfDayToggle() {
                const isHalfDay = $(this).is(':checked');
                const endDateSection = $('#endDateSection');
                
                endDateSection.toggle(!isHalfDay);
                
                // If it's a half day, we don't need an end date
                if (isHalfDay) {
                     $('#EndDate').val('').trigger('change'); // Clear value
                }
                
                recalculateDuration();
            }

            function loadLeaveBalance() {
                const leaveTypeId = $('#leaveTypeSelect').val();
                const employeeId = $('#EmployeeId').val();

                if (!leaveTypeId || !employeeId) {
                    $('#leaveBalanceInfo').html('<div class="text-center text-muted"><i class="fas fa-info-circle"></i> Select a leave type to view balance</div>');
                    return;
                }
                
                $('#leaveBalanceInfo').html('<div class="text-center"><div class="spinner-border spinner-border-sm"></div></div>');
                
                $.get(leaveBalanceUrl, { employeeId, leaveTypeId })
                    .done(function(response) {
                        if (response.success) {
                            const usedPercentage = response.totalDays > 0 ? (response.usedDays / response.totalDays) * 100 : 0;
                            const availableClass = response.remainingDays <= 2 ? 'text-danger' : 'text-success';
                            
                            $('#leaveBalanceInfo').html(`
                                <div class="row text-center">
                                    <div class="col-6"><h4 class="${availableClass} mb-1">${response.remainingDays}</h4><small class="text-muted">Available</small></div>
                                    <div class="col-6"><h4 class="text-warning mb-1">${response.usedDays}</h4><small class="text-muted">Used</small></div>
                                </div>
                                <div class="progress mt-3" style="height: 8px;"><div class="progress-bar" style="width: ${usedPercentage}%"></div></div>
                                <small class="text-muted">Total Allowance: ${response.totalDays} days</small>
                            `);
                        } else {
                            $('#leaveBalanceInfo').html(`<div class="text-center text-warning"><i class="fas fa-exclamation-triangle"></i> ${response.message}</div>`);
                        }
                    })
                    .fail(function() {
                        $('#leaveBalanceInfo').html('<div class="text-center text-danger"><i class="fas fa-times-circle"></i> Error loading balance</div>');
                    });
            }

            /**
             * Helper to update the UI badges for duration.
             */
            function updateDurationSummaryUI(total, working, holidays) {
                $('#totalDays').text(total);
                $('#workingDays').text(working);
                $('#holidayDays').text(holidays);
            }
        });
    </script>
}

<style>
    .progress {
        background-color: #f8f9fa;
    }
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid rgba(0, 0, 0, 0.125);
    }
    .border-end {
        border-right: 1px solid #dee2e6 !important;
    }
    .btn-group .btn {
        margin-right: 0.25rem;
    }
    .form-check-input:checked {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
</style> 