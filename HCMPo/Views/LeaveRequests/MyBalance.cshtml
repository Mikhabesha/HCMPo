@model IEnumerable<HCMPo.Models.EmployeeLeave>

@{
    ViewData["Title"] = "My Leave Balance";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-chart-pie me-2"></i>My Leave Balance - @ViewBag.Year
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5>Employee Information</h5>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Name:</strong></td>
                                    <td>@ViewBag.Employee?.FullName</td>
                                </tr>
                                <tr>
                                    <td><strong>Badge Number:</strong></td>
                                    <td>@ViewBag.Employee?.BadgeNumber</td>
                                </tr>
                                <tr>
                                    <td><strong>Department:</strong></td>
                                    <td>@ViewBag.Employee?.OrganizationUnit?.Name</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="row">
                        @foreach (var balance in Model)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card">
                                    <div class="card-header">
                                        <h6 class="mb-0">@balance.LeaveType?.Name</h6>
                                    </div>
                                    <div class="card-body text-center">
                                        <div class="row">
                                            <div class="col-4">
                                                <h4 class="text-primary">@balance.TotalDays</h4>
                                                <small>Total</small>
                                            </div>
                                            <div class="col-4">
                                                <h4 class="text-warning">@balance.UsedDays</h4>
                                                <small>Used</small>
                                            </div>
                                            <div class="col-4">
                                                <h4 class="text-success">@balance.RemainingDays</h4>
                                                <small>Remaining</small>
                                            </div>
                                        </div>
                                        <div class="progress mt-3" style="height: 8px;">
                                            @{
                                                var percentage = balance.TotalDays > 0 ? (balance.UsedDays / balance.TotalDays * 100) : 0;
                                            }
                                            <div class="progress-bar bg-warning" style="width: @percentage%"></div>
                                        </div>
                                        <small class="text-muted">@percentage.ToString("F1")% used</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="d-flex gap-2">
                                <a asp-action="Create" class="btn btn-primary">
                                    <i class="fas fa-plus me-1"></i>Request Leave
                                </a>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-list me-1"></i>View My Requests
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 