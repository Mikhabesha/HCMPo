@model IEnumerable<HCMPo.Models.LeaveRequest>
@using HCMPo.Models.Enums
@using HCMPo.Helpers

@{
    ViewData["Title"] = "Leave Management";
    var userIsHR = User.IsInRole("Admin") || User.IsInRole("HR");
    var totalRequests = Model.Count();
    var pendingRequests = Model.Count(r => r.Status == HCMPo.Models.Enums.LeaveRequestStatus.Submitted);
    var approvedRequests = Model.Count(r => r.Status == HCMPo.Models.Enums.LeaveRequestStatus.HRApproved);
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-calendar-alt me-2"></i>Leave Management</h2>
            <p class="text-muted mb-0">Manage leave requests and balances</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary me-2">
                <i class="fas fa-plus me-1"></i>New Leave Request
            </a>
            @if (userIsHR)
            {
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-cog me-1"></i>Admin Tools
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-action="Reports"><i class="fas fa-chart-bar me-2"></i>Reports</a></li>
                        <li><a class="dropdown-item" asp-action="ManageEntitlements"><i class="fas fa-users-cog me-2"></i>Manage Entitlements</a></li>
                        <li><a class="dropdown-item" asp-action="Calendar"><i class="fas fa-calendar me-2"></i>Leave Calendar</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-action="InitializeLeaveTypes"><i class="fas fa-database me-2"></i>Initialize System</a></li>
                    </ul>
                </div>
            }
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">@totalRequests</h4>
                            <small>Total Requests</small>
                        </div>
                        <i class="fas fa-list fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">@pendingRequests</h4>
                            <small>Pending Review</small>
                        </div>
                        <i class="fas fa-clock fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">@approvedRequests</h4>
                            <small>Approved</small>
                        </div>
                        <i class="fas fa-check-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a asp-action="MyBalance" class="text-white text-decoration-none">
                                <h6 class="mb-0">My Balance</h6>
                                <small>View Details</small>
                            </a>
                        </div>
                        <i class="fas fa-chart-pie fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="btn-group w-100">
                        <a href="@Url.Action("Create")?quick=1day" class="btn btn-outline-primary">1 Day Leave</a>
                        <a href="@Url.Action("Create")?quick=3days" class="btn btn-outline-primary">3 Days Leave</a>
                        <a href="@Url.Action("Create")?quick=halfday" class="btn btn-outline-primary">Half Day</a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="btn-group w-100">
                        <a asp-action="Calendar" class="btn btn-outline-info">View Calendar</a>
                        <a asp-action="MyBalance" class="btn btn-outline-success">My Balance</a>
                        @if (userIsHR)
                        {
                            <a asp-action="Reports" class="btn btn-outline-warning">Reports</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Filter & Search</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <select class="form-select" id="statusFilter">
                        <option value="">All Status</option>
                        <option value="Submitted">Pending</option>
                        <option value="HRApproved">Approved</option>
                        <option value="HRRejected">Rejected</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="typeFilter">
                        <option value="">All Types</option>
                        <option value="Annual Leave">Annual Leave</option>
                        <option value="Sick Leave">Sick Leave</option>
                        <option value="Personal Leave">Personal Leave</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <input type="text" class="form-control" id="searchInput" placeholder="Search by reason or employee...">
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" onclick="applyFilters()">
                        <i class="fas fa-search me-1"></i>Filter
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Leave Requests Table -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-table me-2"></i>Leave Requests</h5>
            <span class="badge bg-secondary">@totalRequests requests found</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="leaveRequestsTable">
                    <thead class="table-dark">
                        <tr>
                            @if (userIsHR)
                            {
                                <th>Employee</th>
                            }
                            <th>Leave Type</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th>Reason</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr data-status="@item.Status" data-type="@item.LeaveType?.Name">
                                @if (userIsHR)
                                {
                                    <td>
                                        <strong>@item.Employee?.FullName</strong><br>
                                        <small class="text-muted">@item.Employee?.BadgeNumber</small>
                                    </td>
                                }
                                <td>
                                    <span class="badge bg-info">@item.LeaveType?.Name</span>
                                </td>
                                <td>@Html.Raw(EthiopianCalendarHelper.FormatDateWithEthiopian(item.StartDate))</td>
                                <td>@Html.Raw(EthiopianCalendarHelper.FormatDateWithEthiopian(item.EndDate))</td>
                                <td>
                                    <span class="badge bg-primary">@item.TotalDays day@(item.TotalDays != 1 ? "s" : "")</span>
                                </td>
                                <td>
                                    @{
                                        var statusClass = item.Status.ToString() switch
                                        {
                                            "Submitted" => "bg-warning",
                                            "HRApproved" => "bg-success",
                                            "HRRejected" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusClass">@item.Status.ToString().Replace("HR", "").Replace("TeamLeader", "TL")</span>
                                </td>
                                <td>
                                    <span title="@item.Reason" data-bs-toggle="tooltip">
                                        @(item.Reason.Length > 50 ? item.Reason.Substring(0, 50) + "..." : item.Reason)
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (userIsHR && item.Status == HCMPo.Models.Enums.LeaveRequestStatus.Submitted)
                                        {
                                            <a asp-action="Approve" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm" title="Approve">
                                                <i class="fas fa-check"></i>
                                            </a>
                                            <button class="btn btn-outline-danger btn-sm" onclick="rejectRequest('@item.Id')" title="Reject">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reject Leave Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Rejection Reason *</label>
                    <textarea class="form-control" id="rejectionReason" rows="3" placeholder="Please provide a reason for rejection..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmReject()">Reject Request</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentRequestId = '';

        $(document).ready(function() {
            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
            
            // Handle quick action links
            @if (Context.Request.Query.ContainsKey("quick"))
            {
                var quickAction = Context.Request.Query["quick"].ToString();
                <text>
                // Auto-trigger quick action
                setTimeout(function() {
                    @switch (quickAction)
                    {
                        case "1day":
                            <text>window.location.href = '@Url.Action("Create")#quick-1day';</text>
                            break;
                        case "3days":
                            <text>window.location.href = '@Url.Action("Create")#quick-3days';</text>
                            break;
                        case "halfday":
                            <text>window.location.href = '@Url.Action("Create")#quick-halfday';</text>
                            break;
                    }
                }, 100);
                </text>
            }
        });

        function applyFilters() {
            const statusFilter = $('#statusFilter').val();
            const typeFilter = $('#typeFilter').val();
            const searchText = $('#searchInput').val().toLowerCase();
            
            $('#leaveRequestsTable tbody tr').each(function() {
                const row = $(this);
                const status = row.data('status');
                const type = row.data('type');
                const text = row.text().toLowerCase();
                
                let show = true;
                
                if (statusFilter && status !== statusFilter) show = false;
                if (typeFilter && type !== typeFilter) show = false;
                if (searchText && !text.includes(searchText)) show = false;
                
                row.toggle(show);
            });
        }

        function rejectRequest(requestId) {
            currentRequestId = requestId;
            $('#rejectionReason').val('');
            $('#rejectModal').modal('show');
        }

        function confirmReject() {
            const reason = $('#rejectionReason').val().trim();
            if (!reason) {
                alert('Please provide a rejection reason.');
                return;
            }
            
            window.location.href = `@Url.Action("Reject")?id=${currentRequestId}&remarks=${encodeURIComponent(reason)}`;
        }
    </script>
}

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid rgba(0, 0, 0, 0.125);
    }
    .opacity-75 {
        opacity: 0.75;
    }
    .table th {
        border-top: none;
    }
    .btn-group .btn {
        margin-right: 2px;
    }
    .btn-group .btn:last-child {
        margin-right: 0;
    }
</style> 